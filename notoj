def confirm_screen(stdscr, lines):
    """Full-screen interstitial. Returns True to proceed (Enter / y), False to
    cancel (ESC / n / q)."""
    stdscr.timeout(-1)   # block for the answer; the main loop resets this
    stdscr.erase()
    h, w = stdscr.getmaxyx()
    for i, line in enumerate(lines):
        if i + 1 >= h - 1:
            break
        addnstr_w(stdscr, i + 1, 2, line, max(1, w - 3),
                  curses.A_BOLD if i == 0 else curses.A_NORMAL)
    stdscr.refresh()
    eof_spins = 0
    while True:
        t_wait = time.monotonic()
        k = stdscr.getch()
        if k == -1:
            # Dead-terminal guard (see the main loop): a run of instant
            # ERRs means the input is gone — decline and unwind.
            if time.monotonic() - t_wait < 0.01:
                eof_spins += 1
                if eof_spins > 50:
                    return False
            else:
                eof_spins = 0
            continue
        eof_spins = 0
        if k in (10, 13, ord("y"), ord("Y")):
            return True
        if k in (27, ord("n"), ord("N"), ord("q")):
            return False



_footer_band = False   # set in init_colors when the terminal can tint the bar
_message_band = False  # set in init_colors when the status/alert bar can be tinted


_COLOR_NAMES = {"black": 0, "red": 1, "green": 2, "yellow": 3, "blue": 4,
                "magenta": 5, "cyan": 6, "white": 7, "default": -1, "none": -1}


def _color_value(v, default):
    """Resolve a color token — a name (red/green/…/default) or a 0-255 palette
    index — to a curses color number. Falls back to `default`."""
    if not v:
        return default
    v = v.strip().lower()
    if v in _COLOR_NAMES:
        return _COLOR_NAMES[v]
    if v.lstrip("-").isdigit():
        n = int(v)
        if -1 <= n < max(curses.COLORS, 16):
            return n
    return default


def _cfg_color(key, default):
    """Resolve a `color.*` config value to a curses color number."""
    return _color_value(config_get(key), default)


# Modified-date recency gradient: the date / relative-date columns fade from
# warm-bright (just edited) to dim grey (old). DATE_GRADIENT_SPANS are the
# bucket edges, ascending; DATE_GRADIENT_COLORS holds one MORE than the edges
# (the extra is the "older than the last edge" bucket). Both override via
# config (date_gradient / color.date_gradient); 256-color terminals only.
DATE_GRADIENT_SPANS = "1h,3h,6h,12h,1d,1w,1mo,1y"
DATE_GRADIENT_COLORS = "40,10,230,223,11,208,202,102,240"
DATE_RECENT_SECS = 3600     # fallback "recent" cut-off without a 256-color ramp

_date_gradient = None       # [(max_age_secs | None, attr), …] ascending; built in init_colors
_tag_inactive_pair = False  # pair 6 initialized (256-color terminals only)
_tag_preview_pair = False   # pair 7 initialized (256-color terminals only)
_match_focus_pair = False   # pair 8 initialized (256-color terminals only)


def parse_span(s):
    """A recency-bucket duration in seconds, or None. Units: h(our), d(ay),
    w(eek), mo(nth)=30d, y(ear)=365d — e.g. '1h', '12h', '3d', '2w', '1mo'."""
    m = re.fullmatch(r'\s*(\d+(?:\.\d+)?)\s*'
                     r'(h|hr|hrs|hour|hours|d|day|days|w|wk|week|weeks'
                     r'|mo|mon|month|months|y|yr|year|years)\s*',
                     (s or "").lower())
    if not m:
        return None
    secs = {"h": 3600, "d": 86400, "w": 604800, "m": 2592000, "y": 31536000}
    return float(m.group(1)) * secs[m.group(2)[0]]   # only 'month' starts with m


def init_colors():
    global _footer_band, _message_band, _date_gradient
    curses.start_color()
    curses.use_default_colors()

    amber = 214 if curses.COLORS >= 256 else curses.COLOR_YELLOW
    accent = _cfg_color("color.accent", amber)
    # accent = titles, recent dates
    curses.init_pair(1, accent, -1)
    curses.init_pair(2, _cfg_color("color.date", curses.COLOR_RED), -1)
    curses.init_pair(3, _cfg_color("color.tag", curses.COLOR_GREEN), -1)
    curses.init_pair(4, _cfg_color("color.preview", curses.COLOR_CYAN), -1)

    # Search matches get the one hue nothing else in the UI claims. Amber is
    # titles and markdown headers, green is tags, red is dates, cyan is the
    # preview body — a match highlighted in any of those reads as that thing
    # rather than as a hit, which is exactly what a match inside a "# Heading"
    # line used to look like. Magenta is free here, survives the 8-color
    # fallback, and is what vim/less use for search.
    magenta = 205 if curses.COLORS >= 256 else curses.COLOR_MAGENTA
    match = _cfg_color("color.match", magenta)
    curses.init_pair(5, match, -1)

    # Approximate hits: the word the note actually uses where the query was a
    # near-miss ("syncthing" for a typed "syncthign"). Same hue as an exact
    # match — it IS the match — but muted, because the text on screen isn't
    # what was typed.
    curses.init_pair(12, _cfg_color("color.match_fuzzy",
                                    175 if curses.COLORS >= 256
                                    else curses.COLOR_MAGENTA), -1)

    # Rendered markdown headers in the preview. Their own slot rather than
    # borrowing pair 1, so "# Heading" and a match inside it stay distinct and
    # either can be recolored on its own. A muted gold rather than the accent's
    # full-saturation amber: headers are bold too, so the accent glared on
    # every section line — and 214 is also the gradient's "just edited" date
    # bucket, which headers shouldn't be sharing a color with.
    muted_gold = 179 if curses.COLORS >= 256 else curses.COLOR_YELLOW
    curses.init_pair(9, _cfg_color("color.header", muted_gold), -1)

    # Footer status bar: default fg over a gray band, distinct enough to read
    # as the screen's bottom edge so every row above it can hold content.
    if curses.COLORS >= 256:
        footer_bg = _cfg_color("color.footer_bg", 239)
        curses.init_pair(10, -1, footer_bg)
        _footer_band = True

        # Status / alert message bar (cross-session undo prompts, stale-skip
        # notices). Default is the inverse of the title look — the accent and
        # footer-band colors swapped, so amber text on default becomes default
        # text on an amber band — a clear highlighted alert. Both ends override.
        msg_fg = _cfg_color("color.message_fg", footer_bg)
        msg_bg = _cfg_color("color.message_bg", accent)
        curses.init_pair(11, msg_fg, msg_bg)
        _message_band = True

        # The in-focus match — the one n/N is sitting on — is the match color
        # worn as a band instead of as text, so the current hit reads as a
        # cursor among the other hits (Vim's CurSearch vs Search). Without 256
        # colors there's no second color to spend on it and match_focus_attr()
        # falls back to reverse video, which lands in the same place.
        curses.init_pair(8, _cfg_color("color.match_focus_fg", 235),
                         _cfg_color("color.match_focus_bg", match))
        global _match_focus_pair
        _match_focus_pair = True

        # Modified-date recency gradient. One bucket per edge plus a final
        # "older" bucket, so len(colors) should be len(spans)+1; a short color
        # list reuses its last entry, a long one is truncated.
        spans = sorted({s for s in (parse_span(t) for t in
                        config_get("date_gradient", DATE_GRADIENT_SPANS).split(",")) if s})
        cols = [c for c in (c.strip() for c in
                config_get("color.date_gradient", DATE_GRADIENT_COLORS).split(",")) if c]
        if not cols:
            cols = DATE_GRADIENT_COLORS.split(",")
        gradient = []
        for i in range(len(spans) + 1):
            curses.init_pair(20 + i, _color_value(cols[min(i, len(cols) - 1)], 240), -1)
            gradient.append((spans[i] if i < len(spans) else None,
                             curses.color_pair(20 + i)))
        _date_gradient = gradient

        # Inactive (parenthesised) tags in the tag-filter header: by default
        # the same dim grey the date gradient fades to for the oldest notes,
        # overridable via color.tag_inactive.
        curses.init_pair(6, _cfg_color("color.tag_inactive",
                                       _color_value(cols[-1], 240)), -1)
        global _tag_inactive_pair
        _tag_inactive_pair = True

        # Tag-completion preview (the dimmed "ghost" suffix shown at the cursor
        # while typing in the tag prompt). Defaults to the same dim grey as the
        # inactive tags, overridable via color.tag_preview.
        curses.init_pair(7, _cfg_color("color.tag_preview",
                                       _color_value(cols[-1], 240)), -1)
        global _tag_preview_pair
        _tag_preview_pair = True


def footer_attr():
    """Attr for the footer bar (row h-1): gray band, or reverse video — the
    classic status-line look — without 256 colors."""
    if _footer_band:
        return curses.color_pair(10)
    return curses.A_REVERSE


def message_attr():
    """Attr for the status/alert message bar — an amber band with the inverse
    text by default (see init_colors), set via color.message_fg/_bg; reverse
    video without 256 colors so it still stands apart from the footer."""
    if _message_band:
        return curses.color_pair(11) | curses.A_BOLD
    return curses.A_REVERSE | curses.A_BOLD


def tag_inactive_attr():
    """Attr for tags present but not filtered on (the parenthesised ones in
    the tag-filter header): the configured grey on 256-color terminals, plain
    dim elsewhere."""
    if _tag_inactive_pair:
        return curses.color_pair(6)
    return curses.A_DIM


def tag_preview_attr():
    """Attr for the dimmed 'ghost completion' suffix at the tag prompt cursor,
    signaling it's a preview (not yet accepted). On 256-color terminals uses the
    configured color.tag_preview; otherwise plain dim so it reads as a hint."""
    if _tag_preview_pair:
        return curses.color_pair(7)
    return curses.A_DIM


def md_header_attr():
    """Attr for a rendered markdown header line in the preview. Its own slot
    (color.header) so headers can be told apart from both the title column and
    the search-match color; defaults to the accent, which is what they were
    always meant to be."""
    return curses.color_pair(9)


def match_attr():
    """Attr for a search match that isn't the one in focus."""
    return curses.color_pair(5) | curses.A_BOLD


def match_fuzzy_attr():
    """Attr for an approximate hit — the corrected word behind a near-miss."""
    return curses.color_pair(12)


def match_focus_attr():
    """Attr for the in-focus match (the one n/N has landed on): the match color
    as a band on 256-color terminals, reverse video everywhere else."""
    if _match_focus_pair:
        return curses.color_pair(8) | curses.A_BOLD
    return curses.color_pair(5) | curses.A_REVERSE | curses.A_BOLD


def date_attr(ts, now):
    """Curses attr for a modification timestamp, from the recency gradient
    (warm/bright = fresh → dim grey = old). Falls back to the binary
    accent/date colors where the 256-color gradient isn't available."""
    if not _date_gradient:
        recent = ts and (now - float(ts)) < DATE_RECENT_SECS
        return curses.color_pair(1) if recent else curses.color_pair(2)
    age = now - float(ts or 0)
    for thresh, attr in _date_gradient:
        if thresh is None or age < thresh:
            return attr
    return _date_gradient[-1][1]


def fit_hints(segments, width):
    """Build the footer from (priority, text) hint segments, joined by two
    spaces. When it doesn't fit, drop whole segments — highest priority
    number first, rightmost first within a tie — instead of letting the
    right edge truncate mid-hint. Empty texts are skipped."""
    segs = [(pri, txt) for pri, txt in segments if txt]
    while True:
        s = "  ".join(t for _, t in segs)
        if disp_width(s) <= width or len(segs) <= 1:
            return s
        worst = max(p for p, _ in segs)
        for i in range(len(segs) - 1, -1, -1):
            if segs[i][0] == worst:
                del segs[i]
                break


def char_width(ch):
    """Display columns a character occupies. Deliberately conservative: any
    glyph that *might* render double-width (CJK, fullwidth, ambiguous, arrows,
    symbols, emoji) counts as 2. A clipped string then never overflows its pane
    and wraps into the neighbouring column — which is what painted preview text
    over the left list. Over-truncating an accented line by a column at the far
    right edge is invisible; under-counting corrupts the screen."""
    if unicodedata.combining(ch):
        return 0
    o = ord(ch)
    if o < 0x20:
        return 0
    if o < 0x7f:                                        # ASCII printable
        return 1
    if unicodedata.east_asian_width(ch) in ("W", "F", "A"):
        return 2
    if o >= 0x2190:                                     # arrows / symbols / emoji
        return 2
    return 1


def disp_width(s):
    if s.isascii():            # fast path: plain ASCII is one column per char
        return len(s)
    return sum(char_width(c) for c in s)


def clip_to_width(s, max_w):
    """Truncate s so its display width does not exceed max_w columns."""
    if max_w <= 0:
        return ""
    if s.isascii():            # fast path: ASCII is one column per char, so a
        return s[:max_w]       # character slice is already a column slice
    w = 0
    for i, ch in enumerate(s):
        w += char_width(ch)
        if w > max_w:
            return s[:i]
    return s


# --- Arabic-script display shaping ------------------------------------------
# Terminals shape contiguous runs, but curses writes cell-by-cell, so any
# Arabic-script text (Arabic, Urdu, Persian, Pashto, …) shows isolated. We
# pre-shape to presentation forms here (display-only; the file on disk is
# never touched). Ligatures OFF keeps it 1 char -> 1 form so column widths are
# unchanged. Bidi is left to the terminal (VTE).
try:
    import arabic_reshaper as _ar
    _reshaper = _ar.ArabicReshaper(configuration={
        'delete_harakat': False,
        'support_ligatures': False,
    })

    def _reshape(s):
        # Arabic *script* (covers Urdu, Persian, Pashto, Sindhi, Uyghur,
        # Kurdish…), the only script with Unicode presentation forms to swap
        # to. Trigger ranges: Arabic, Arabic Supplement, Arabic Extended-A/B,
        # and the two presentation-form blocks.
        if not config_bool("reshape_arabic", True):
            return s
        for ch in s:
            o = ord(ch)
            if (0x600 <= o <= 0x6ff or 0x750 <= o <= 0x77f
                    or 0x870 <= o <= 0x8ff
                    or 0xfb50 <= o <= 0xfdff or 0xfe70 <= o <= 0xfeff):
                return _reshaper.reshape(s)
        return s
except Exception:
    def _reshape(s):
        return s


def addnstr_w(win, y, x, text, max_w, attr=0):
    """Display-width-aware addnstr: the single place every pane draws dynamic
    text through. Clips `text` to max_w *columns* (not characters) so wide
    glyphs (emoji, em-dash, CJK, arrows) can't overrun the budget and wrap into
    the neighbouring column, and swallows the edge-of-window curses error so
    callers don't each need their own try/except."""
    text = clip_to_width(text, max_w)
    if not text:
        return
    disp = _reshape(text)
    try:
        win.addnstr(y, x, disp, len(disp), attr)
    except curses.error:
        pass


def search_tokens(q):
    """The lowercased substrings a query highlights on: a quoted "phrase" is
    one token, anything else splits on whitespace. Mirrors how rank_notes
    reads the same query, so what's ranked is what's highlighted."""
    q = (q or "").strip()
    if not q:
        return []
    if q.startswith('"') and q.endswith('"') and len(q) > 2:
        return [q[1:-1].lower()]
    return q.lower().split()


def tag_at(tag_text, pos):
    """The tag whose word covers character `pos` of a tags string ("#a #b" or
    "a b") — which tag a highlighted run belongs to."""
    start = tag_text.rfind(" ", 0, pos) + 1
    end = tag_text.find(" ", pos)
    return tag_text[start:end if end != -1 else len(tag_text)].lstrip("#")


def _tags_fm_lines(fm_lines):
    """Indices of the frontmatter lines that hold the `tags` value — the
    `tags:` line itself, plus the `  - item` lines under it when it's written
    as a block list rather than a flow list."""
    out, in_block = [], False
    for i, line in enumerate(fm_lines):
        if in_block and line.startswith("  - "):
            out.append(i)
            continue
        in_block = False
        if line.partition(":")[0].strip() == "tags":
            out.append(i)
            in_block = not line.partition(":")[2].strip()
    return out


def tag_file_position(note, tag, tokens):
    """(1-based file line, ordinal on that line) of `tag` in the note's
    frontmatter — where Vim should open when the search matched a tag, so the
    cursor lands on the tag itself instead of falling back to the title.

    The ordinal counts the query's own matches earlier on the line, because
    that's what Vim will be stepping over: the frontmatter key ("tags") can
    match the query too."""
    fm = note.get("fm_text") if note else None
    if not fm or not tag:
        return None
    lines = fm.split("\n")
    for i in _tags_fm_lines(lines):
        raw = lines[i]
        j = raw.lower().find(tag.lower())
        if j < 0:
            continue
        for k, (s, _e, _t) in enumerate(match_spans(raw, tokens)):
            if s >= j:
                # +1 for the opening "---" above the frontmatter, +1 for Vim's
                # 1-based lines.
                return (i + 2, k)
    return None


def match_spans(text, tokens):
    """The (start, end, token) spans `text` matches on, leftmost first and
    non-overlapping — one definition of "the matches on this line", shared by
    both renderers and by the n/N navigation so the k-th match a renderer
    paints is the k-th match n/N counts."""
    if not text or not tokens:
        return []
    tl = text.lower()
    spans, pos = [], 0
    while pos < len(text):
        best = None
        for tok in tokens:
            if not tok:
                continue
            idx = tl.find(tok, pos)
            if idx != -1 and (best is None or idx < best[0]):
                best = (idx, tok)
        if best is None:
            break
        mi, tok = best
        spans.append((mi, mi + len(tok), tok))
        pos = mi + len(tok)
    return spans


_Hi = collections.namedtuple("Hi", "tokens attr fuzzy fuzzy_attr focus focus_attr")


class Hi(_Hi):
    """How to paint one line's search hits: the substrings to look for, and
    the attribute for a plain hit, for an approximate one, and for the hit in
    focus. `fuzzy` holds the corrected spellings — they're searched for
    literally like any other token, but drawn as the guesses they are."""

    __slots__ = ()

    def __new__(cls, tokens, attr, fuzzy=(), fuzzy_attr=None,
                focus=None, focus_attr=None):
        return _Hi.__new__(cls, tokens, attr, fuzzy, fuzzy_attr,
                           focus, focus_attr)

    def attr_for(self, k, tok):
        """The attribute for the k-th hit on the line, matched by `tok`."""
        if k == self.focus and self.focus_attr is not None:
            return self.focus_attr
        if self.fuzzy_attr is not None and tok in self.fuzzy:
            return self.fuzzy_attr
        return self.attr

    def at(self, focus):
        """The same spec with the focus moved (or cleared)."""
        return self._replace(focus=focus)


def active_term(state, tokens):
    """The single query term Tab has narrowed navigation to, or None while all
    of them are in play. Out-of-range indices read as "all", so a filter left
    over from a longer query can't outlive it."""
    i = (state or {}).get("qf", -1)
    return tokens[i] if 0 <= i < len(tokens) else None


def cycle_term(state, tokens, delta=1):
    """Step the term filter: all → first → … → last → all, the same cycle Tab
    walks in a tag-filter view. False when there's nothing to cycle."""
    n = len(tokens)
    if n < 2:
        state["qf"] = -1
        return False
    i = state.get("qf", -1)
    i = (i if -1 <= i < n else -1) + delta
    state["qf"] = -1 if i >= n else (n - 1 if i < -1 else i)
    return True


def note_terms(note, tokens, state=None):
    """(terms, corrections) for a note: the query terms in play — all of them,
    or the one Tab singled out — and the corrected spellings of whatever those
    terms only nearly matched here.

    Corrections are always worked out against the WHOLE query, so narrowing
    changes which terms are live and never what a term means."""
    fz = fuzzy_words(note, tokens) if note else {}
    term = active_term(state, tokens)
    keep = [term] if term is not None else list(tokens)
    return keep, sorted({w for t in keep for w in fz.get(t, ())})


def highlight_tokens(note, tokens, state=None):
    """The substrings to look for in a note: the query's live tokens plus the
    corrections behind any near-miss.

    Everything downstream — the highlighting, the n/N match list, the pattern
    handed to Vim — works off this one list, so an approximate hit is a hit
    everywhere or nowhere, and a narrowed term is narrowed everywhere."""
    if not note or not tokens:
        return list(tokens)
    keep, words = note_terms(note, tokens, state)
    return keep + words


# The header's "why is this note here" summary. One entry per query term, in
# the order typed: the term as typed, the text that actually matched, how many
# times that occurs in the note, and whether it's a correction rather than the
# term itself. `token` and `term` differ only for a correction — it's what ties
# an entry back to the term Tab can narrow to.
Matched = collections.namedtuple("Matched", "token term count fuzzy")

SUMMARY_PREFIX = "matched:"
# Prefixes a term the query only came close to. ASCII on purpose: the obvious
# "≈" (like "×" for the count) is an East-Asian *Ambiguous* character, which
# disp_width measures as two columns and the terminal draws as one — enough to
# put every term after it one column out when the header is recolored.
FUZZY_MARK = "~"


def match_summary(note, tokens):
    """What matched in `note`, per query term — the answer to "why is this in
    my results", which ranking alone never states.

    Counts every occurrence in the note (title, tags and body), not just the
    ones the preview can show, because the question is about the note and not
    about the pane. A term that matched nothing is reported with a count of
    zero: in a multi-word query that's the interesting one, since a note only
    has to match a single term to rank at all. A term that only came close
    reports the word the note really uses."""
    if not note or not tokens:
        return []
    t, body, tag_str = search_text(note)
    fz = fuzzy_words(note, tokens)
    out = []
    for tok in tokens:
        n = t.count(tok) + tag_str.count(tok) + body.count(tok)
        if n:
            out.append(Matched(tok, tok, n, False))
            continue
        # No literal hit: report the nearest word the note does use, picking
        # the one it uses most.
        best = max((w for w in fz.get(tok, ())),
                   key=lambda w: t.count(w) + tag_str.count(w) + body.count(w),
                   default=None)
        if best is None:
            out.append(Matched(tok, tok, 0, False))
        else:
            out.append(Matched(tok, best,
                               t.count(best) + tag_str.count(best)
                               + body.count(best), True))
    return out


def match_summary_text(items):
    """(text, [(offset, length, item)]) for the header's match summary — the
    string plus where each term sits in it, so the terms can be recolored to
    the same palette they're highlighted with in the panes."""
    if not items:
        return "", []
    text = SUMMARY_PREFIX
    spans = []
    for i, it in enumerate(items):
        text += " " if i == 0 else ", "
        term = (FUZZY_MARK + it.term) if it.fuzzy else it.term
        spans.append((len(text), len(term), it))
        text += "%s (%d)" % (term, it.count)
    return text, spans


def hi_for(note, tokens, attr, focus=None, focus_attr=None, state=None):
    """The Hi for a note's line: the query's live tokens, plus the corrected
    spelling of anything the query only nearly matched in THIS note — which is
    what makes a fuzzy hit visible instead of a result with nothing marked."""
    keep, words = note_terms(note, tokens, state)
    return Hi(keep + words, attr, frozenset(words),
              match_fuzzy_attr(), focus, focus_attr)


def draw_line_highlighted(stdscr, y, x, text, max_w, base_attr, hi):
    """Render text at (y, x), switching attribute on the hits `hi` describes.

    Column accounting is by display width, so wide glyphs (emoji, em-dash, CJK,
    arrows) advance the cursor by their true width and the line is clipped to
    max_w *columns* — it can't run past the pane and wrap into the next row."""
    text = clip_to_width(text, max_w)
    if not text:
        return
    spans = match_spans(text, hi.tokens) if hi else []
    if not spans:
        addnstr_w(stdscr, y, x, text, max_w, base_attr)
        return
    pos = 0
    col = x
    rem = max_w                       # remaining budget, in display columns
    for k, (mi, me, tok) in enumerate(spans):
        if rem <= 0:
            break
        if mi > pos:
            seg = text[pos:mi]
            addnstr_w(stdscr, y, col, seg, rem, base_attr)
            w = disp_width(seg)
            col += w
            rem -= w
            pos = mi
            if rem <= 0:
                break
        seg = text[mi:me]
        addnstr_w(stdscr, y, col, seg, rem, hi.attr_for(k, tok))
        w = disp_width(seg)
        col += w
        rem -= w
        pos = me
    if pos < len(text) and rem > 0:
        addnstr_w(stdscr, y, col, text[pos:], rem, base_attr)


# --- Markdown preview styling -----------------------------------------------
# Light inline rendering for the preview pane (display-only — the file is never
# touched). Markers are dropped; the spanned text takes a curses attribute:
#   # Heading   -> bold + amber        **bold** / ***both***  -> bold (+italic)
#   *italic*    -> italic              `code`                 -> reverse video
#   ~~strike~~  -> combining overlay (real strikethrough; curses has no attr)
# Only asterisk emphasis is honored (not _underscores_) so snake_case and
# __dunder__ identifiers in code/text aren't accidentally styled. curses
# A_ITALIC is recent; fall back to underline where it's absent.
MD_ITALIC = getattr(curses, "A_ITALIC", curses.A_UNDERLINE)
MD_STRIKE = "̶"
MD_HEADER = re.compile(r"(#{1,6})\s+(.*)$")

_md_inline_re = None


def _md_inline_pattern():
    """Compiled inline-markdown regex, assembled from config (cached). Asterisk
    emphasis is on by default; underscore emphasis is off by default so
    snake_case (_) and __dunder__ (__) identifiers aren't accidentally styled.
    `code` and ~~strike~~ are always on (no false-positive risk)."""
    global _md_inline_re
    if _md_inline_re is None:
        ast = config_bool("markdown_asterisk", True)
        parts = [r"(?P<code>`[^`]+`)"]
        if ast:
            parts.append(r"(?P<bi>\*\*\*[^*]+?\*\*\*)")
            parts.append(r"(?P<b>\*\*[^*]+?\*\*)")
        if config_bool("markdown_underscore_bold", False):
            parts.append(r"(?P<bu>__[^_]+?__)")
        parts.append(r"(?P<s>~~[^~]+?~~)")
        if ast:
            parts.append(r"(?P<i>\*[^*\s][^*]*?\*)")
        if config_bool("markdown_underscore_italic", False):
            parts.append(r"(?P<iu>_[^_\s][^_]*?_)")
        _md_inline_re = re.compile("|".join(parts))
    return _md_inline_re


def _md_entries(raw, base_attr):
    """Parse one preview line into [(logical_char, draw_string, attr)]. The
    logical char drives token-search matching and width; the draw string is
    what's painted (identical, except struck chars carry a combining overlay)."""
    m = MD_HEADER.match(raw)
    if m:
        # The header's own color replaces the base color rather than being
        # OR-ed onto it: curses packs the pair number into the attribute as a
        # bit field, so pair 4 (the preview body) | pair 1 (the accent) is
        # pair 5 — the search-match slot. That arithmetic is why headers used
        # to come out in whatever color color.match was set to.
        a = md_header_attr() | curses.A_BOLD
        return [(c, c, a) for c in m.group(2)]
    out = []
    pos = 0
    for mt in _md_inline_pattern().finditer(raw):
        if mt.start() > pos:
            out += [(c, c, base_attr) for c in raw[pos:mt.start()]]
        g, s = mt.lastgroup, mt.group()
        strike = False
        if g == "code":
            inner, a = s[1:-1], base_attr | curses.A_REVERSE
        elif g == "bi":
            inner, a = s[3:-3], base_attr | curses.A_BOLD | MD_ITALIC
        elif g in ("b", "bu"):           # **bold** or __bold__
            inner, a = s[2:-2], base_attr | curses.A_BOLD
        elif g == "s":
            inner, a, strike = s[2:-2], base_attr, True
        else:                            # i (*italic*) or iu (_italic_)
            inner, a = s[1:-1], base_attr | MD_ITALIC
        out += [(c, (c + MD_STRIKE) if strike else c, a) for c in inner]
        pos = mt.end()
    if pos < len(raw):
        out += [(c, c, base_attr) for c in raw[pos:]]
    return out


def draw_markdown_line(stdscr, y, x, raw, max_w, base_attr, hi):
    """Like draw_line_highlighted but renders inline markdown; search hits
    still win, overriding the markdown attribute on the matched run."""
    entries = _md_entries(raw, base_attr)
    if not entries:
        return
    if hi and hi.tokens:
        # Matched against the logical (marker-stripped) text, which is what the
        # reader sees — so a hit inside **bold** or a `# Heading` is found where
        # it looks like it is.
        spans = match_spans("".join(e[0] for e in entries), hi.tokens)
        hot = [None] * len(entries)
        for k, (start, end, tok) in enumerate(spans):
            attr = hi.attr_for(k, tok)
            for j in range(start, end):
                hot[j] = attr
        entries = [(e[0], e[1], hot[k] if hot[k] is not None else e[2])
                   for k, e in enumerate(entries)]
    col, rem, i, n = x, max_w, 0, len(entries)
    while i < n and rem > 0:
        attr = entries[i][2]
        j = i
        while j < n and entries[j][2] == attr:
            j += 1
        seg = "".join(e[1] for e in entries[i:j])
        addnstr_w(stdscr, y, col, seg, rem, attr)
        w = disp_width(seg)
        col += w
        rem -= w
        i = j


# ----------------------------
# List navigation (shared by the main list, tags view, and history view)
# ----------------------------

# Sentinel nav_delta result: G — jump to the last item. (gg is a chord and
# stays decoded per surface; only the resulting jump-to-top is trivial.)
NAV_BOTTOM = "bottom"

# Sentinel nav_delta result: h/m/l — jump within the visible page. The target
# depends on the scroll window, which nav_delta can't see, so surfaces resolve
# it through screen_target().
NAV_SCREEN = "screen"

# The vim-style within-page jumps: high / middle / low.
SCREEN_KEYS = {ord("h"), ord("m"), ord("l")}

# Every key nav_delta understands; surfaces gate their nav branch on this.
NAV_KEYS = {ord("j"), ord("k"), ord("G"),
            curses.KEY_DOWN, curses.KEY_UP,
            4, 21, 6, 2} | SCREEN_KEYS   # Ctrl-d, Ctrl-u, Ctrl-f, Ctrl-b


def typed_char_getch(getch, k):
    """The text a printable keypress contributes to an input field, or None if
    `k` isn't printable. getch() delivers a multibyte UTF-8 character one byte
    at a time, so a lead byte (0xC0..0xF7) pulls its continuation bytes and the
    whole codepoint is decoded — that's what lets Arabic, accents and emoji be
    typed into the search / tag / schedule fields. `getch` is a zero-arg
    callable so EditBuffer (and tests) can supply input without a screen."""
    if 32 <= k <= 126:
        return chr(k)
    if 0xC0 <= k <= 0xF7:
        extra = 1 + (k >= 0xE0) + (k >= 0xF0)   # bytes that follow the lead
        buf = bytes([k] + [getch() & 0xFF for _ in range(extra)])
        try:
            return buf.decode("utf-8")
        except UnicodeDecodeError:
            return None
    return None


def word_boundary(s, pos, forward):
    """Index of the next word boundary from `pos` in `s`, readline-style: skip
    any run of whitespace, then a run of word characters. `forward` scans right,
    otherwise left. Used by Ctrl-W (delete previous word) and, later, the
    Alt-b / Alt-f word motions."""
    i = pos
    if forward:
        n = len(s)
        while i < n and s[i].isspace():
            i += 1
        while i < n and not s[i].isspace():
            i += 1
    else:
        while i > 0 and s[i - 1].isspace():
            i -= 1
        while i > 0 and not s[i - 1].isspace():
            i -= 1
    return i


class EditBuffer:
    """One readline-style single-line text field for every input in the app —
    the note search, the modal views' "/" filter, and the tag / schedule
    prompts — so editing behaves identically everywhere and a new input is a
    few lines, not a re-implementation.

    State is `text` plus an insertion cursor `pos`. handle_key(k, getch, peek)
    consumes one keypress and returns:
      "submit"   Enter
      "cancel"   bare ESC (no Meta follow-up)
      "changed"  text mutated (callers re-filter / reset their list)
      "moved"    only the cursor moved
      None       key not ours (caller decides: nav, mode keys, ...)

    `getch` is a zero-arg callable supplying the bytes after a UTF-8 lead;
    `peek` (defaults to getch) supplies the ESC follow-up byte and should
    return -1 when nothing is pending — curses callers wrap a short
    timeout around stdscr.getch, tests feed lists. Curses-free by design."""

    def __init__(self, text=""):
        self.text = text
        self.pos = len(text)

    def handle_key(self, k, getch, peek=None):
        q, p = self.text, self.pos

        if k == 27:  # ESC — bare ESC cancels; ESC+letter is a Meta (Alt) chord.
            nxt = (peek or getch)()
            if nxt in (ord("b"), ord("B")):        # Alt-b — back one word
                self.pos = word_boundary(q, p, forward=False)
                return "moved"
            if nxt in (ord("f"), ord("F")):        # Alt-f — forward one word
                self.pos = word_boundary(q, p, forward=True)
                return "moved"
            if nxt in (ord("d"), ord("D")):        # Alt-d — delete word ahead
                end = word_boundary(q, p, forward=True)
                if end > p:
                    self.text = q[:p] + q[end:]
                    return "changed"
                return "moved"
            if nxt in (curses.KEY_BACKSPACE, 127, 8):  # Alt-⌫ — delete word back
                start = word_boundary(q, p, forward=False)
                if start < p:
                    self.text = q[:start] + q[p:]
                    self.pos = start
                    return "changed"
                return "moved"
            # Nothing followed (-1) = bare ESC. A stray non-Meta key is
            # dropped; ESC's cancel takes precedence.
            return "cancel"

        if k in (10, 13):
            return "submit"

        if k in (curses.KEY_LEFT, 2):              # ← / Ctrl-b
            self.pos = max(0, p - 1)
            return "moved"
        if k in (curses.KEY_RIGHT, 6):             # → / Ctrl-f
            self.pos = min(len(q), p + 1)
            return "moved"
        if k in (curses.KEY_HOME, 1):              # Home / Ctrl-a
            self.pos = 0
            return "moved"
        if k in (curses.KEY_END, 5):               # End / Ctrl-e
            self.pos = len(q)
            return "moved"

        if k in (curses.KEY_BACKSPACE, 127, 8):    # ⌫ — delete char before cursor
            if p > 0:
                self.text = q[:p - 1] + q[p:]
                self.pos = p - 1
                return "changed"
            return "moved"
        if k == 4:                                 # Ctrl-d — delete char under cursor
            if p < len(q):
                self.text = q[:p] + q[p + 1:]
                return "changed"
            return "moved"
        if k == 23:                                # Ctrl-w — delete word back
            start = word_boundary(q, p, forward=False)
            if start < p:
                self.text = q[:start] + q[p:]
                self.pos = start
                return "changed"
            return "moved"
        if k == 21:                                # Ctrl-u — delete to line start
            if p > 0:
                self.text = q[p:]
                self.pos = 0
                return "changed"
            return "moved"
        if k == 11:                                # Ctrl-k — delete to line end
            if p < len(q):
                self.text = q[:p]
                return "changed"
            return "moved"

        ch = typed_char_getch(getch, k)
        if ch:
            self.text = q[:p] + ch + q[p:]
            self.pos = p + len(ch)
            return "changed"
        return None


def filter_indices(items, match, q):
    """Positions in `items` whose element matches the lowercased query — the
    index map behind every "/" list filter, so a filtered cursor position
    can always be traced back to the original item. Empty query = identity."""
    ql = q.lower()
    if not ql:
        return list(range(len(items)))
    return [i for i, it in enumerate(items) if match(it, ql)]


def preview_geometry(w):
    """Split a terminal w columns wide into (show_preview, list_w, mid,
    preview_w). Shared by the drawing code and the scroll keys so both agree
    on how wide the preview pane is."""
    if (w - w // 2 - 5) >= MIN_PREVIEW_W:
        list_w = min(w // 2 - 2, LIST_MAX_W)
        mid = list_w + 2
        # Preview runs from mid+1 to the last column (w-1): no right margin,
        # mirroring the list starting flush at column 0 on the left.
        return True, list_w, mid, w - (mid + 1)
    return False, w - 1, None, 0


def wrap_to_width(line, width):
    """Greedy word wrap into rows at most `width` COLUMNS wide, continuation
    rows keeping the line's indentation. Measured with disp_width, the same
    ruler the drawing code uses — textwrap counts characters, so one "→" (an
    East-Asian-Ambiguous glyph, two columns here) would push a row past the
    pane and cost it its last character. A word too long for a row is broken."""
    indent = line[:len(line) - len(line.lstrip())]
    avail = width - disp_width(indent)
    if avail < 1:
        indent, avail = "", width
    rows, cur = [], ""
    for word in line[len(indent):].split(" "):
        cand = word if not cur else cur + " " + word
        if disp_width(cand) <= avail:
            cur = cand
            continue
        if cur:
            rows.append(cur)
            cur = ""
        while disp_width(word) > avail:
            head = clip_to_width(word, avail)
            if not head:
                break
            rows.append(head)
            word = word[len(head):]
        cur = word
    rows.append(cur)
    return [indent + r for r in rows]


# Wrapped rows for the notes most recently previewed, keyed by the text and
# the pane width. Every keypress redraws the preview, and PgDn measures it a
# second time to clamp the scroll; wrapping a long note on each of those is
# what made scrolling lag. The rows are computed when you land on a note and
# reused until the note, its text, or the pane width changes. Callers must
# treat the list as read-only.
_PREVIEW_ROWS = collections.OrderedDict()
_PREVIEW_ROWS_MAX = 8


def wrap_preview_rows(lines, width):
    """Source lines as the rows a preview pane draws: tabs expanded, then
    wrapped to `width` when the `preview_wrap` config is on (the default) and
    left to clip at the pane edge when it is off.

    Each row is (text, src_i, last) — the index of the line it came from, and
    whether it is that line's final row. Carrying the index rather than a
    finished string is what lets every preview keep its own painting while
    sharing one wrap: the history diff maps src_i to its +/- color so a
    wrapped line stays green across continuations, and the tag pane uses
    `last` to park a note's date after its final row. This is the single
    place that consults preview_wrap; previews that wrap by hand drift out of
    step with it, which is exactly how the history diff lost wrapping."""
    wrap = width > 0 and config_bool("preview_wrap", True)
    out = []
    for i, line in enumerate(lines):
        line = line.expandtabs(4)
        parts = (wrap_to_width(line, width)
                 if wrap and disp_width(line) > width else [line])
        out.extend((p, i, j == len(parts) - 1) for j, p in enumerate(parts))
    return out


class PreviewRows:
    """Per-view wrap cache for the modal previews (history diff, tag notes,
    backlink hits). `source(key)` yields the lines for a selection; rows()
    wraps them and holds the result until the selection or the pane width
    changes — every keypress redraws the pane and PgDn measures it again, so
    re-wrapping per call is what made the notes preview lag before it was
    memoized. Callers must treat the returned list as read-only.

    The notes pane keeps its own global cache (_PREVIEW_ROWS) instead: it is
    keyed by note text rather than by a selection index, so it survives moving
    away from a note and back."""

    def __init__(self, source):
        self._source = source
        self._key = self._width = self._rows = None

    def rows(self, key, width):
        if self._rows is not None and (self._key, self._width) == (key, width):
            return self._rows
        self._key, self._width = key, width
        self._rows = wrap_preview_rows(self._source(key), width)
        return self._rows

    def count(self, key):
        # PgDn clamps against drawn rows. Before the pane has drawn at this
        # key there is no width to wrap to, so fall back to the source count.
        if self._rows is not None and self._key == key:
            return len(self._rows)
        return len(self._source(key))

    def invalidate(self):
        self._key = self._width = self._rows = None


def preview_source_rows(text, width):
    """A note's text as (row, source line index) pairs — the rows the preview
    pane draws, each tagged with the line of `text` it came from. With
    `preview_wrap` on (the default) a line wider than the pane continues on the
    next row, keeping its indentation; with it off each source line is one row
    and the overflow is clipped at the pane edge.

    The source index is what lets a position on screen be turned back into a
    position in the note — which row 12 of a wrapped preview can't say on its
    own, and which is how opening in Vim lands on the right line.

    Memoized per (text, width) — see _PREVIEW_ROWS. The returned list is
    shared with the cache: read it, never mutate it."""
    wrap = width > 0 and config_bool("preview_wrap", True)

    # hash() over the note body is O(1) after CPython caches it on the str,
    # which the note dict holds for as long as the note is loaded. Compare the
    # text as well, so a hash collision serves the wrong note's rows. The
    # no-wrap rows are width-independent; key them as width 0.
    key = (hash(text), len(text), width if wrap else 0)
    hit = _PREVIEW_ROWS.get(key)
    if hit is not None and hit[0] == text:
        _PREVIEW_ROWS.move_to_end(key)
        return hit[1]

    # Shares wrap_preview_rows with the modal previews so one config knob and
    # one wrap rule serve every pane; the `last` flag is for the panes that
    # park something after a line's final row, which this one doesn't. Both
    # views are cached together — deriving one from the other per call would
    # rebuild a list per frame and undo the memoization.
    rows = [(r[0], r[1]) for r in wrap_preview_rows(text.split("\n"),
                                                    width if wrap else 0)]
    _PREVIEW_ROWS[key] = (text, rows, [r[0] for r in rows])
    if len(_PREVIEW_ROWS) > _PREVIEW_ROWS_MAX:
        _PREVIEW_ROWS.popitem(last=False)
    return rows


def preview_body_lines(text, width):
    """Just the row text of preview_source_rows — for the panes that only paint
    rows and never map them back to the note."""
    preview_source_rows(text, width)          # fills / refreshes the entry
    wrap = width > 0 and config_bool("preview_wrap", True)
    return _PREVIEW_ROWS[(hash(text), len(text), width if wrap else 0)][2]


PREVIEW_TAGS_DEFAULT = "always"


def preview_tag_row(note, tokens, state):
    """The note's tags as a row to prepend to the preview when the query
    matched one of them, else None.

    Tags live in the frontmatter, which never reaches `content` — so a note
    that ranked purely on a tag arrived as a result with nothing on screen
    explaining why ("Welcome to Nottingham" for a `notoj` query). This is that
    explanation, in the pane you're already looking at.

    `preview_tags`: always (default), narrow — only when the list panel is too
    tight to be showing its tags column, so the row appears exactly when the
    other copy of the tags has gone — or never."""
    if note is None or not tokens:
        return None
    mode = (config_get("preview_tags", PREVIEW_TAGS_DEFAULT)
            or PREVIEW_TAGS_DEFAULT).strip().lower()
    if mode == "never" or (mode == "narrow" and state.get("_tags_col_shown")):
        return None
    tg = tags(note)
    if not tg:
        return None
    # Written as #hashtags, the way the tag prompt and the tags view show
    # them, so the row reads as tags rather than as a line of the note.
    row = " ".join("#" + t for t in tg.split())
    lc = row.lower()
    return row if any(tok in lc for tok in tokens) else None


def preview_rows(note, tokens, width, state):
    """The preview pane's rows as (text, source line) pairs, the tag row (if
    any) first with a source of None — it isn't in the note's text, so nothing
    downstream should try to map it back there. One definition shared by the
    drawing, the scroll clamp and the match list, so all three agree on what
    row 0 is."""
    if note is None:
        return []
    body = preview_source_rows(content(note), width)
    tg = preview_tag_row(note, tokens, state)
    if not tg:
        return body      # the cached list itself: read it, never mutate it
    return [(r[0], None) for r in wrap_preview_rows([tg], width)] + list(body)


def preview_scroll_step(page_h):
    """Lines PgDn/PgUp move a preview pane, from the `preview_scroll` config:
    "page" (default) scrolls a full pane height; a positive integer scrolls
    that many lines. One knob for every preview — notes body, history diff,
    tag / backlink previews."""
    v = (config_get("preview_scroll", "page") or "page").strip().lower()
    if v.isdigit() and int(v) > 0:
        return int(v)
    return max(1, page_h)


def preview_max_scroll(note, state, w, h):
    """Highest p_scroll that still shows content — the pane's row count minus
    one screenful, floored at 0. Shared by every PgDn on the notes list (search
    mode included) so the pane stops at the end of the note instead of
    scrolling into blank space. Counted in drawn rows, pane height h - 2, and
    it counts the tag row when there is one."""
    if note is None:
        return 0
    preview_w = preview_geometry(w)[3]
    rows = preview_rows(note, search_tokens(state.get("q", "")),
                        preview_w, state)
    return max(0, len(rows) - (h - 2))


def preview_scroll_key(k, state, note, w, h):
    """Apply a PgDn/PgUp keypress to state["p_scroll"], clamped to the note.
    True if the key was a page key and was consumed."""
    if k == curses.KEY_NPAGE:
        state["p_scroll"] = min(preview_max_scroll(note, state, w, h),
                                state["p_scroll"] + preview_scroll_step(h - 2))
        return True
    if k == curses.KEY_PPAGE:
        state["p_scroll"] = max(0, state["p_scroll"]
                                - preview_scroll_step(h - 2))
        return True
    return False


# One navigable search hit. `row`/`ord` place it on screen — the ordinal is
# what the renderers count matches by, so the entry the navigation is on and
# the run drawn in the focus color are the same run; row None means the hit
# isn't in the preview pane at all but in the list's tags column. `src`/
# `src_ord` place the same hit in the note's text (which a wrapped row can't
# give on its own), so opening in Vim lands on it; src is None for a hit that
# isn't in the body. `tag` names the tag a hit belongs to, for the hits that
# are tags — that's how they're located in the frontmatter.
Match = collections.namedtuple("Match", "row ord src src_ord tag")


def preview_match_list(rows, tokens, render_md):
    """Every token match in a pane's rows — as produced by preview_rows — in
    reading order."""
    if not tokens or not rows:
        return []
    out = []
    per_src = {}                  # src line -> matches counted so far on it
    for i, (raw, src) in enumerate(rows):
        # Match the logical (marker-stripped) text when markdown is rendered,
        # so the counting agrees with draw_markdown_line. The tag row is drawn
        # literally, so it's counted literally.
        line = ("".join(e[0] for e in _md_entries(raw, 0))
                if render_md and src is not None else raw)
        spans = match_spans(line, tokens)
        seen = per_src.get(src, 0)
        out.extend(Match(i, j, src, seen + j,
                         tag_at(line, s) if src is None else None)
                   for j, (s, _e, _t) in enumerate(spans))
        per_src[src] = seen + len(spans)
    return out


def column_tag_matches(note, tokens):
    """Hits on the note's tags as shown in the list's tags column, for when the
    preview isn't carrying a tag row. A tag is a real match wherever it's
    drawn, so n/N steps through these too — and lands the highlight on the
    column instead of the pane."""
    tg = tags(note) if note else ""
    if not tg or not tokens:
        return []
    return [Match(None, j, None, None, tag_at(tg, s))
            for j, (s, _e, _t) in enumerate(match_spans(tg, tokens))]


def reveal_preview_row(row, state, note, w, h):
    """The p_scroll that brings preview `row` into view, moving the pane as
    little as it can and keeping a line of context above the row. A hit that
    isn't in the pane (row None — the tags column) leaves the scroll alone."""
    top = state["p_scroll"]
    if row is None or top <= row < top + (h - 2):
        return top
    return max(0, min(preview_max_scroll(note, state, w, h), row - 1))


def sync_preview_matches(state, note, tokens, w, h):
    """Keep the preview's match list, focus index and scroll in step with the
    selected note and the live query; returns the list.

    Recomputed only when the note, the query, the pane width or the tag row
    changes — which is also when the focus resets to the first match and the
    pane snaps to it, so a search result opens on its first occurrence instead
    of at line 1. The cache key deliberately excludes p_scroll, so PgDn/PgUp
    scroll freely afterwards without the pane snapping back."""
    preview_w = preview_geometry(w)[3]
    render_md = config_bool("render_markdown", True)
    tag_row = preview_tag_row(note, tokens, state)
    key = (note["path"] if note else None, tuple(tokens), preview_w,
           render_md, tag_row, state.get("_tags_col_shown"))
    if state.get("_match_key") != key:
        state["_match_key"] = key
        ms = preview_match_list(
            preview_rows(note, tokens, preview_w, state), tokens, render_md)
        if not tag_row and state.get("_tags_col_shown"):
            # The tags aren't in the pane but they are on the row, so the hit
            # is still visible and still worth stepping onto. Tags come first
            # for the same reason they're drawn above the body: they're the
            # note's frontmatter.
            ms = column_tag_matches(note, tokens) + ms
        state["_matches"] = ms
        state["m_idx"] = 0
        if ms:
            state["p_scroll"] = reveal_preview_row(ms[0].row, state, note, w, h)
    return state["_matches"]


def match_step(state, note, tokens, w, h, delta):
    """Move the in-focus match by `delta` (n forward, N back), wrapping at the
    ends, and scroll the preview to it. False when there's nothing to step."""
    ms = sync_preview_matches(state, note, tokens, w, h)
    if not ms:
        return False
    state["m_idx"] = (state.get("m_idx", 0) + delta) % len(ms)
    state["p_scroll"] = reveal_preview_row(ms[state["m_idx"]].row,
                                           state, note, w, h)
    return True


def focused_match(state):
    """The in-focus Match, or None when there isn't one."""
    ms = state.get("_matches") or []
    i = state.get("m_idx", 0)
    return ms[i] if 0 <= i < len(ms) else None


def vim_match_position(state, note, tokens):
    """(file line, ordinal-on-that-line) for the match the preview is focused
    on — where Vim should open the note, so stepping to the 3rd hit and hitting
    Enter enters the file on the 3rd hit. A hit on a tag resolves to the
    frontmatter line the tag is written on, not the title. None when nothing is
    focused, when the match list belongs to a different note, or when the note
    carries no body offset (an unparsed file) — each of which leaves the plain
    jump-to-the-first-match positioning in place."""
    if not note or (state.get("_match_key") or (None,))[0] != note.get("path"):
        return None
    m = focused_match(state)
    if m is None:
        return None
    if m.tag:
        return tag_file_position(note, m.tag, tokens)
    body_line = note.get("body_line")
    if m.src is None or body_line is None:
        return None
    return (body_line + m.src + 1, m.src_ord)


def nav_delta(k, page_h):
    """Decode a list-motion key into a cursor delta (or NAV_BOTTOM, or None
    for non-motion keys). One decoder for every list surface, so a new
    motion key lands everywhere at once: j/k/arrows one row, Ctrl-d/u half a
    page, Ctrl-f/b a full page minus one row of overlap, G the bottom,
    h/m/l a jump inside the visible page (resolved by screen_target)."""
    if k in SCREEN_KEYS:
        return NAV_SCREEN
    if k in (ord("j"), curses.KEY_DOWN):
        return 1
    if k in (ord("k"), curses.KEY_UP):
        return -1
    if k == 4:    # Ctrl-d
        return max(1, page_h // 2)
    if k == 21:   # Ctrl-u
        return -max(1, page_h // 2)
    if k == 6:    # Ctrl-f
        return max(1, page_h - 1)
    if k == 2:    # Ctrl-b
        return -max(1, page_h - 1)
    if k == ord("G"):
        return NAV_BOTTOM
    return None


def screen_target(k, off, page_h, n_items):
    """Row index for an h/m/l jump: the first, middle, or last item currently
    on screen, given the scroll offset `off` and the page height. Short pages
    (fewer items than rows) measure from the real last item, so l lands on it
    rather than on empty space."""
    last = min(off + page_h, n_items) - 1
    if last < off:
        return off
    if k == ord("h"):
        return off
    if k == ord("l"):
        return last
    return (off + last) // 2


def clamp_list(state, n_items, page_h):
    """Clamp state["cur"] to the list bounds and scroll state["off"] so the
    cursor stays on screen."""
    state["cur"] = max(0, min(state["cur"], max(0, n_items - 1)))
    if state["cur"] < state["off"]:
        state["off"] = state["cur"]
    elif state["cur"] >= state["off"] + page_h:
        state["off"] = state["cur"] - page_h + 1


def clamp_scroll(state, filtered, height):
    # rows 1..h-2 hold notes; the footer bar sits at h-1
    clamp_list(state, len(filtered), height - 2)


# ----------------------------
# Drawing
# ----------------------------

MSG_ROTATE_SECS = 1.6   # how long each pooled status message shows before the
                        # one-line bar rotates to the next (only when rotating)
MSG_JOIN = "  ·  "      # separator when the whole pool fits on one line


def pool_msg(state, width=None):
    """Render the status bar from its message pool. When the messages all fit
    on the line they are shown whole, joined on one row with no counter. Only
    when that would overflow `width` do they fall back to cycling one at a time
    with an (i/n) prefix (rotation happens on the idle tick) — so nothing is
    ever truncated or wrapped off the line. A lone message always shows bare."""
    pool = state.get("_msg_pool") or []
    if not pool:
        return None
    if len(pool) == 1:
        return pool[0]
    joined = MSG_JOIN.join(pool)
    if width is None or disp_width(joined) <= width:
        return joined
    i = state.get("_msg_idx", 0) % len(pool)
    return f"({i + 1}/{len(pool)}) {pool[i]}"


def draw(stdscr, notes, state):
    stdscr.erase()

    h, w = stdscr.getmaxyx()

    if h < 3 or w < MIN_W_ERROR:
        addnstr_w(stdscr, 0, 0, "window too narrow", w)
        stdscr.refresh()
        return

    show_preview, list_w, mid, preview_w = preview_geometry(w)

    show_date = list_w >= SHOW_DATE_MIN
    show_ago  = list_w >= SHOW_AGO_MIN

    conflicts = state.get("_conflicts", [])   # scanned on the idle tick, not per frame
    conflict_badge = f" | [{len(conflicts)} conflict(s)]" if conflicts else ""
    dup_badge = f" | [{len(state['_dups'])} dup(s) — gd]" if state.get("_dups") else ""
    loop_badge = f" | [{state['_loops_due']} loop(s) due — gr]" if state.get("_loops_due") else ""
    # The "filter:" field only shows while you're actually searching — same in
    # every view (notes / trash / duplicates / loops).
    filt = f" | filter:{state['q']}" if (state["q"] or state.get("search_mode")) else ""

    # …and right behind it, what that filter actually matched in the selected
    # note. It rides with the filter into every view, and sits ahead of the
    # sort and the badges so it's the last thing a narrowing terminal drops.
    tokens = search_tokens(state["q"])
    cur_note = notes[state["cur"]] if 0 <= state["cur"] < len(notes) else None
    # Built from the whole query even when Tab has narrowed navigation: the
    # summary is the note's answer, and the terms it isn't stepping through
    # right now are greyed rather than dropped.
    summary, summary_spans = match_summary_text(match_summary(cur_note, tokens))
    live = active_term(state, tokens)
    if summary:
        filt += " | " + summary
    if state.get("tag_mode"):
        header = f"{TAG_PROMPT}{state['tag_input']}"
    elif state.get("sched_mode"):
        header = f"{SCHED_PROMPT}{state['sched_input']}"
    elif state.get("trash_mode"):
        sort = sort_label(state["sort"], state["rev"], state["q"], "modified 🞃", False)
        header = f"trash ({len(notes)} notes){filt} | sort:{sort}{conflict_badge}"
    elif state.get("dup_mode") is not None:
        sort = sort_label(state["sort"], state["rev"], state["q"], "grouped", True)
        header = f"duplicates ({len(notes)} notes){filt} | sort:{sort}{conflict_badge}"
    elif state.get("review_mode"):
        sort = sort_label(state["sort"], state["rev"], state["q"], "most stale first", True)
        header = f"resurface ({len(notes)} loop(s) due){filt} | sort:{sort}{conflict_badge}"
    elif state.get("tagf") is not None:
        sort = sort_label(state["sort"], state["rev"], state["q"], "modified 🞃", False)
        header = f"tagged {tagf_label(state['tagf'])} ({len(notes)} notes){filt} | sort:{sort}{conflict_badge}"
    else:
        sort = sort_label(state["sort"], state["rev"], state["q"], "modified 🞃", False)
        header = f"notes{filt} | sort:{sort}{conflict_badge}{dup_badge}{loop_badge}"

    # Header rule: underline the top row edge to edge. Unlike the content rows
    # (whose mixed colors made a row-wide underline look patchy), everything
    # here is the default color, so the underline reads as one continuous line.
    try:
        stdscr.hline(0, 0, ord(" ") | curses.A_UNDERLINE, w)
    except curses.error:
        pass
    addnstr_w(stdscr, 0, 0, header, w - 1, curses.A_UNDERLINE)

    if state.get("tag_mode"):
        # Dimmed "ghost" suffix: the first tag completing what was just typed,
        # shown as a preview so Tab is no longer blind. Drawn after the header
        # (which ends in the real tag_input) so the cursor sits at the end of the
        # actual text; the preview is purely visual and dismissed on Enter/ESC.
        preview = state.get("_tag_preview", "")
        if preview and config_bool("tag_preview", True):
            x0 = disp_width(header)
            if x0 < w - 1:
                addnstr_w(stdscr, 0, x0, preview, w - 1 - x0,
                          tag_preview_attr() | curses.A_UNDERLINE)

    if state["q"] or state.get("search_mode"):
        # The live filter value in the accent color, same as the modal "/"
        # searches, so the two filter fields read as one feature.
        anchor = header.find("filter:")
        if anchor >= 0 and state["q"]:
            q_x = disp_width(header[:anchor + len("filter:")])
            if q_x < w - 1:
                addnstr_w(stdscr, 0, q_x, state["q"], w - 1 - q_x,
                          curses.color_pair(1) | curses.A_UNDERLINE)

    if summary:
        # Recolor each matched term to the palette it's highlighted with in
        # the panes: the match color, the muted one for a correction, and the
        # inactive grey for a term that found nothing — or, once Tab has
        # narrowed the navigation, for every term it isn't stepping through.
        anchor = header.find(summary)
        for off, ln, it in (summary_spans if anchor >= 0 else []):
            x = disp_width(header[:anchor + off])
            if x >= w - 1:
                break
            dropped = live is not None and it.token != live
            if not it.count or dropped:
                attr = tag_inactive_attr()
            elif it.fuzzy:
                attr = match_fuzzy_attr()
            else:
                attr = match_attr()
            addnstr_w(stdscr, 0, x, summary[off:off + ln], w - 1 - x,
                      attr | curses.A_UNDERLINE)

    if state.get("tagf") is not None:
        # Recolor the header's tag tokens so they read like the tags column:
        # tags being filtered on in the tag color, the parenthesised
        # (present-but-inactive) ones in the dim inactive grey.
        tf = state["tagf"]
        col = disp_width("tagged ")
        for i, t in enumerate(tf["tags"]):
            active = tf["idx"] < 0 or i == tf["idx"]
            tok = "#" + t if active else "(#" + t + ")"
            attr = curses.color_pair(3) if active else tag_inactive_attr()
            if col >= w - 1:
                break
            addnstr_w(stdscr, 0, col, tok, w - 1 - col,
                      attr | curses.A_UNDERLINE)
            col += disp_width(tok) + 1

    visible = notes[state["off"]:state["off"] + h - 2]

    # When sorted by creation date, the date and (age) columns track
    # creationDate instead of modificationDate — forward and reverse alike, with
    # the same format and recency color.
    date_field = "creationDate" if state.get("sort") == "created" else "modificationDate"

    # Tags align in one column, 2 spaces past the widest date+relative-date
    # among the rows on screen (not the whole list), and appear as soon as a
    # single column of them fits.
    ago_strs = [f"({ago(n.get(date_field))})" for n in visible]
    if show_ago:
        block_end = COL_AGO + max((len(a) for a in ago_strs), default=0)
    else:
        block_end = COL_DATE + 16   # date only (16-char timestamp)
    tag_col = block_end + 2
    # Whether this width leaves room for the tags column at all — what
    # `preview_tags = narrow` keys off, so the preview's tag row appears
    # exactly when the list's copy of the tags has been squeezed out.
    state["_tags_col_shown"] = bool(show_date and tag_col < list_w)

    # Resolve the match list before anything is painted: both panes ask which
    # hit is in focus, and the left one is drawn first. On a new note or a
    # changed query this also snaps the preview to the first match, which is
    # what makes a result open on its first occurrence.
    sync_preview_matches(state, cur_note,
                         highlight_tokens(cur_note, tokens, state), w, h)

    # ----------------------------
    # LEFT PANE
    # ----------------------------

    now_ts = datetime.now().timestamp()
    for i, n in enumerate(visible):
        y = i + 1

        attr_title = curses.color_pair(1)
        attr_date = date_attr(n.get(date_field), now_ts)
        attr_tag = curses.color_pair(3)

        selected = (i == state["cur"] - state["off"])
        if selected:
            attr_title |= curses.A_REVERSE

        t = title(n)
        tg = tags(n)

        # Per row, because the corrected spelling behind a near-miss is a
        # property of the note, not of the query: two rows can have ranked for
        # the same typo through different words of their own.
        row_hi = hi_for(n, tokens,
                        match_attr() | (curses.A_REVERSE if selected else 0),
                        state=state)
        title_w = min(28, list_w)
        # Fill the whole title column with the row's attribute first so the
        # focus highlight always spans the full column, regardless of any
        # drift between computed and actual on-screen glyph width (e.g.
        # Unicode "Ambiguous"-width characters like em dash).
        try:
            stdscr.addnstr(y, 0, " " * title_w, title_w, attr_title)
        except curses.error:
            pass
        t_clip = clip_to_width(t, title_w)
        draw_line_highlighted(stdscr, y, 0, t_clip, title_w, attr_title, row_hi)

        if show_date:
            m = fmt(n.get(date_field))
            # +1 budget so the zero-width LRM doesn't clip the last char.
            stdscr.addnstr(y, COL_DATE, LRM + m, min(1 + len(m), list_w - COL_DATE), attr_date)

        if show_ago:
            ago_str = ago_strs[i]
            stdscr.addnstr(y, COL_AGO, LRM + ago_str, min(1 + len(ago_str), list_w - COL_AGO), attr_date)

        if show_date and tg and tag_col < list_w:
            # Highlighted like the title: a tag is a first-class way to match,
            # and an unmarked one leaves a result with no visible reason for
            # being in the list. On the selected row it also carries the focus
            # band when n/N has stepped onto a tag that the preview isn't
            # showing — the hit has to be visible wherever it lives.
            fm = focused_match(state) if selected else None
            tag_hi = Hi(row_hi.tokens, match_attr(), row_hi.fuzzy,
                        match_fuzzy_attr(),
                        fm.ord if fm is not None and fm.row is None else None,
                        match_focus_attr())
            draw_line_highlighted(stdscr, y, tag_col, tg, list_w - tag_col,
                                  attr_tag, tag_hi)

    # ----------------------------
    # RIGHT PANE (preview)
    # ----------------------------

    if show_preview:
        for y in range(1, h - 1):
            stdscr.addch(y, mid, curses.ACS_VLINE)

        cur_idx = state["cur"]

        if 0 <= cur_idx < len(notes):
            cur = notes[cur_idx]

            cur_tokens = highlight_tokens(cur, tokens, state)
            rows = preview_rows(cur, cur_tokens, preview_w, state)
            fm = focused_match(state)
            focus_row, focus_ord = (fm.row, fm.ord) if fm else (None, None)
            body_hi = hi_for(cur, tokens, match_attr(),
                             focus_attr=match_focus_attr(), state=state)

            start = state["p_scroll"]
            end = start + h - 2
            render_md = config_bool("render_markdown", True)

            for i, (line, src) in enumerate(rows[start:end]):
                if i >= h - 2:
                    break

                # rows from preview_rows are already tab-expanded and
                # newline-free. The tag row (src None) is drawn literally, in
                # the tag color — it's frontmatter, not note text, so neither
                # the markdown renderer nor the body color applies to it.
                draw_body = (draw_markdown_line if render_md and src is not None
                            else draw_line_highlighted)
                draw_body(
                    stdscr, i + 1, mid + 1, line, preview_w,
                    curses.color_pair(4) if src is not None else curses.color_pair(3),
                    body_hi.at(focus_ord if start + i == focus_row else None),
                )

    # Footer hints as (priority, text) segments: lower number = survives
    # longer as the terminal narrows. ⮐/e are one segment (e = open at end).
    hc = state.get("_hist_count", 0)
    if state.get("trash_mode"):
        segments = [
            (2, "gt exit trash"), (3, "/ search"),
            (2, "⮐/e edit (saving restores)"), (2, "u restore"),
            (4, "ESC clear/exit"), (1, "q quit"),
        ]
    elif state.get("dup_mode") is not None:
        segments = [
            (2, "gd exit dups"), (3, "/ search"), (2, "⮐/e open"),
            (3, "d trash"), (4, "ESC clear/exit"), (1, "q quit"),
        ]
    elif state.get("review_mode"):
        segments = [
            (4, "ESC clear/exit"), (5, "/ search"), (3, "⮐/e open"),
            (2, "z snooze"), (2, "S schedule"), (2, "x done"),
            (3, "d trash"), (6, "u/^R undo"), (1, "q quit"),
        ]
    elif state.get("tagf") is not None:
        many = len(state["tagf"]["tags"]) > 1
        # Both cycles can be live here; name whichever key each one is on so
        # the tab_in_tag_view setting doesn't have to be remembered.
        terms_key = "⇥" if tab_cycles_terms_in_tag_view() else "⇧⇥"
        tags_key = "⇧⇥" if tab_cycles_terms_in_tag_view() else "⇥"
        segments = [
            (2, f"{tags_key} cycle tag" if many else ""),
            (2, f"{terms_key} term:{live or 'all'}"
                if len(tokens) > 1 else ""),
            (3, "/ search"),
            (2, "⮐/e open"), (4, "t refilter"), (5, "# tag"),
            (4, "d trash"), (3, "ESC clear/exit"), (1, "q quit"),
        ]
    else:
        # Match counter: only while a query is live, and it outranks most hints
        # — it's the one segment that says where n/N will land next.
        ms = state.get("_matches") or []
        m_hint = (f"n/N match {state.get('m_idx', 0) + 1}/{len(ms)}"
                  if ms and tokens else "")
        # …and, for a multi-term query, which term those matches are of. The
        # color change in the header says it too, but only if you were looking.
        t_hint = (("⇥ term:" + (live or "all")) if len(tokens) > 1 else "")
        segments = [
            (2, m_hint), (2, t_hint),
            (3, f"{action_label('new', 'o')} new"), (2, "/ search"),
            (7, "s/r sort"), (2, "⮐/e open"),
            (5, "#/. tag" if state.get("_last_tags") else "# tag"),
            (6, "t/T tags"), (10, "b backlinks"), (4, "d trash"),
            (10, "gt trash-view"), (8, "u/^R undo"),
            (9, "h/H hist" if hc >= 2 else ""),
            (2, "c conflicts" if conflicts else ""),
            (3, "? help"), (1, "q quit"),
        ]
    footer = fit_hints(segments, w - 1)

    # Footer as a full-width status bar: the tinted strip marks the bottom
    # edge, so no content row above needs sacrificing to a separator.
    try:
        stdscr.hline(h - 1, 0, ord(" ") | footer_attr(), w)
    except curses.error:
        pass
    addnstr_w(stdscr, h - 1, 0, footer, w - 1, footer_attr())

    # A transient prompt/warning (cross-session undo, stale-skip) takes over the
    # footer row in amber until the next keystroke resolves or dismisses it.
    msg = pool_msg(state, w - 1)
    if msg:
        attr = message_attr()
        try:
            stdscr.hline(h - 1, 0, ord(" ") | attr, w)
        except curses.error:
            pass
        addnstr_w(stdscr, h - 1, 0, msg, w - 1, attr)

    if state["search_mode"] or state.get("tag_mode") or state.get("sched_mode"):
        def buf_pos(key):
            # Insertion-cursor column within a prompt's text: the EditBuffer's
            # pos when its text is current, else end-of-text (buffer not yet
            # created, or the mirror was reset elsewhere).
            buf = state.get("_buf_" + key)
            ok = buf is not None and buf.text == state[key]
            return buf.pos if ok else len(state[key])

        if state.get("tag_mode"):
            cursor_col = min(len(TAG_PROMPT) + buf_pos("tag_input"), w - 1)
        elif state.get("sched_mode"):
            cursor_col = min(len(SCHED_PROMPT) + buf_pos("sched_input"), w - 1)
        else:
            # Place the cursor right after the query in the live "filter:" field,
            # wherever it sits in this view's header (notes / trash / dup / loops).
            anchor = header.find("filter:")
            base_col = anchor + len("filter:") if anchor >= 0 else 0
            q_pos = min(state.get("q_pos", len(state["q"])), len(state["q"]))
            cursor_col = min(base_col + q_pos, w - 1)
        show_input_cursor(stdscr, cursor_col)
    else:
        hide_input_cursor(stdscr)


# ----------------------------
# Main loop
# ----------------------------

def run(stdscr, imports=(), move=False):
    git_init()

    # Adopt any files named on the command line before the first load(), so
    # they come up as ordinary notes. Paths were validated in __main__; a
    # failure here is a copy that lost a race, and is reported in the bar.
    # A path already inside the vault (notoj is the .md handler, so a note can
    # arrive this way) is not re-imported — it is just the one to select.
    imported, failed = [], []
    focus = None
    vault = os.path.abspath(NOTES_DIR)
    for src in imports:
        if os.path.dirname(src) == vault:
            focus = focus or src
            continue
        final = import_file(src, move)
        (imported if final else failed).append(final or src)
        if final and not focus:
            focus = final

    curses.curs_set(0)
    set_term_title("notoj")
    init_colors()
    KEY = build_key_dispatch()   # {action: keycode}, with config rebindings
    CHORDS, CHORD_PREFIXES = build_chord_dispatch()   # 2-key chords (gg/gt/…)
    stdscr.timeout(2000)
    if hasattr(curses, "set_escdelay"):
        # Keep bare ESC snappy (default is up to 1s) and bound the window in
        # which an ESC+letter is gathered as a Meta/Alt chord in the filter.
        curses.set_escdelay(25)

    # Restore the undo/redo stacks from previous sessions, trimming the journal
    # first if it has grown large, then mark this session's start.
    compact_log()
    _undo0, _redo0 = load_undo()
    log_event({"t": "session", "ev": "launch", "sess": SESSION_ID})

    state = {
        "cur": 0,
        "off": 0,
        "p_scroll": 0,
        "q": "",
        "q_pos": 0,             # insertion-cursor index into q while searching
        "qf": -1,               # term n/N is narrowed to (Tab); -1 = all of them
        "sort": "relevance",
        "rev": True,
        "search_mode": False,
        "tag_mode": False,
        "tag_input": "",
        "_tag_preview": "",
        "_last_tags": "",
        "dup_mode": None,
        "_dups": [],
        "trash_mode": False,
        "_trash": None,         # cached trash listing; None = reload on next draw
        "_trash_gen": 0,        # bumped per reload — the cache-key marker for _trash
        "review_mode": False,
        "tagf": None,           # tag-filter view: {"tags": [...], "idx": -1|i}
        "_tags_ui": {"mode_i": 0},   # tags view sort mode, kept across visits
        "sched_mode": False,
        "sched_input": "",
        "_review": load_review(),
        "_loops_due": 0,
        "_undo": _undo0,
        "_redo": _redo0,
        # One-line amber status bar. Distinct messages for the current action
        # are pooled (deduped) and rotated through the single line with an
        # (i/n) counter rather than truncated or wrapped — see pool_msg().
        "_msg_pool": [],
        "_msg_idx": 0,
        "_msg_rot": 0.0,        # monotonic time of the last rotation
        "_xsess_armed": None,   # ("undo"|"redo", sess) while a cross-session prompt waits
        "_hist_path": None,
        "_hist_count": 0,
        "_hist_dirty": False,
        "_hist_cache": {},      # path -> commit count (lazy; cleared on change)
        "_conflicts": [],
        "_filter_cache": {},    # memoized rank/filter, rebuilt only on real input change
    }

    notes = load()
    set_tag_freq(notes)
    snap = file_snapshot(NOTES_DIR)
    if prune_review(state["_review"], notes):
        save_review(state["_review"])
    state["_dups"] = find_duplicates(notes)
    state["_loops_due"] = len(find_loops(notes, state["_review"]))
    state["_conflicts"] = find_conflicts()

    saved = load_cursor()
    if saved:
        state["_restore_path"] = saved

    # A file named on the command line wins over the saved cursor: you asked
    # for it, so it is what the preview should be showing.
    if focus:
        state["_restore_path"] = focus
    if imported or failed:
        state["_msg_pool"] = import_msgs(imported, failed)
        state["_msg_rot"] = time.monotonic()

    def refresh_notes():
        nonlocal notes, snap
        new_snap = file_snapshot(NOTES_DIR)
        notes, changed = incremental_update(notes, snap, new_snap)
        # incremental_update may rename files (title normalization), so after
        # a change re-snapshot — like the idle scan does — rather than keeping
        # pre-rename paths that would be reprocessed on the next tick.
        snap = file_snapshot(NOTES_DIR) if changed else new_snap
        set_tag_freq(notes)
        state["_trash"] = None
        state["_dups"] = find_duplicates(notes)
        # Inline "#loop <when>" scheduling writes the review file from inside
        # the update pipeline, so reload it rather than trust the in-memory copy.
        state["_review"] = load_review()
        state["_loops_due"] = len(find_loops(notes, state["_review"]))
        state["_conflicts"] = find_conflicts()
        state["_hist_cache"].clear()   # commit counts may have changed
        if state["dup_mode"] is not None:
            state["dup_mode"] = state["_dups"]

    def push_msg(*texts):
        """Add status line(s) to the bar's pool for the current action, deduped.
        Several distinct messages share the one line and rotate (see pool_msg)
        rather than overwrite each other or overflow — so a long prompt is split
        into parts that cycle, never truncated."""
        for text in texts:
            if text and text not in state["_msg_pool"]:
                state["_msg_pool"].append(text)
        state["_msg_rot"] = time.monotonic()   # show the new message a full beat

    def clear_msgs():
        state["_msg_pool"] = []
        state["_msg_idx"] = 0

    def record(act):
        """Push a fresh destructive action onto the undo stack; a new action
        invalidates the redo stack (standard undo/redo semantics) and is
        journaled so it survives across sessions."""
        if act:
            act["sess"] = SESSION_ID
            state["_undo"].append(act)
            state["_redo"] = []
            log_event({"t": "act", "sess": SESSION_ID, "act": act})

    def undo_step():
        """Apply the top undo act. A stale note (changed underneath an edit) is
        skipped with a message, leaving the stacks untouched."""
        act = state["_undo"][-1]
        focus = undo_action(act, state["_review"])
        if focus is STALE:
            push_msg("undo skipped — note changed elsewhere since this edit")
            return
        state["_undo"].pop()
        state["_redo"].append(act)
        log_event({"t": "undo", "sess": SESSION_ID})
        refresh_notes()
        if focus:
            state["_restore_path"] = focus
        state["p_scroll"] = 0

    def redo_step():
        act = state["_redo"][-1]
        focus = redo_action(act, state["_review"])
        if focus is STALE:
            push_msg("redo skipped — note changed elsewhere since this edit")
            return
        state["_redo"].pop()
        state["_undo"].append(act)
        log_event({"t": "redo", "sess": SESSION_ID})
        refresh_notes()
        if focus:
            state["_restore_path"] = focus
        state["p_scroll"] = 0

    def xsess_arm(direction, sess):
        """Arm the cross-session confirmation and pool its message. The prompt is
        pushed as two parts — the situation and the controls — so on a narrow
        terminal they rotate through the bar instead of the single long line
        being clipped. Worded by whether the other session is a still-running
        instance or a finished previous one."""
        state["_xsess_armed"] = (direction, sess)
        clear_msgs()
        if session_alive(sess):
            push_msg(f"next change is from another running notoj — {direction} "
                     f"it anyway?",
                     "y to confirm, any other key cancels")
        else:
            push_msg(f"already at the oldest change of this session — {direction} "
                     f"from a previous session?",
                     "y/u to continue, any other key cancels")

    def xsess_step(direction):
        if direction == "undo" and state["_undo"]:
            undo_step()
        elif direction == "redo" and state["_redo"]:
            redo_step()

    def open_selected(note, end=False):
        """Open `note` in Vim. An active search query is carried into Vim so the
        matches are highlighted and the cursor lands on the one the preview was
        showing — step to the 3rd hit with n/N and Vim opens on the 3rd hit,
        with `n` carrying on from there. A note that ranked on a near-miss
        carries the corrected word into Vim as well, so an approximate hit is
        highlighted and reachable there too. Trashed notes first get an
        interstitial saying that saving any change restores them from the
        trash."""
        toks = search_tokens(state["q"])
        fz = fuzzy_words(note, toks) if note else {}
        term = active_term(state, toks)
        at_pat = None
        if term is None:
            search = vim_search_pattern(
                state["q"], sorted({w for ws in fz.values() for w in ws}))
        else:
            # Tab has narrowed navigation to one term. Under the default
            # vim_search_scope=term Vim gets that term alone, so its n/N cycle
            # is the one just being used; under =query it gets the whole query
            # and the narrower pattern only places the cursor.
            term_pat = vim_search_pattern(term, fz.get(term, ()))
            if vim_search_scope() == "query":
                search = vim_search_pattern(
                    state["q"], sorted({w for ws in fz.values() for w in ws}))
                at_pat = term_pat
            else:
                search = term_pat
        at = vim_match_position(state, note,
                                highlight_tokens(note, toks, state))
        if state["trash_mode"]:
            if confirm_screen(stdscr, TRASH_EDIT_NOTICE):
                restored = edit_trash_note(note, end=end, search=search,
                                           at=at, at_pat=at_pat)
                refresh_notes()
                state["_hist_path"] = None
                if restored:
                    state["_restore_path"] = restored
        else:
            record(open_note(note, end=end, search=search, at=at,
                             at_pat=at_pat))
            refresh_notes()
            state["_hist_path"] = None
            state["_restore_path"] = note["path"]

    last_scan = time.monotonic()   # throttles the external-change / conflict scan
    SCAN_EVERY = 2.0

    def esc_peek():
        # ESC follow-up byte for EditBuffer's Alt chords: a real Alt-key sends
        # ESC and the letter back-to-back, so it's already buffered after
        # set_escdelay; look with a short window (the loop resets the timeout
        # each iteration).
        stdscr.timeout(25)
        return stdscr.getch()

    def prompt_buf(state, key):
        # The EditBuffer behind a prompt (search / tag / schedule), stored in
        # state and re-created whenever the mirrored text was reset elsewhere,
        # so external `state[key] = ""` resets keep working unchanged.
        buf = state.get("_buf_" + key)
        if buf is None or buf.text != state[key]:
            buf = state["_buf_" + key] = EditBuffer(state[key])
        return buf

    while True:
        # Pick up terminal resizes live: ncurses won't refresh getmaxyx() on
        # its own between key presses, so poll the real size and resize when it
        # changes. This makes the list reflow (more/fewer columns) immediately.
        try:
            ts = os.get_terminal_size()
            if (ts.lines, ts.columns) != stdscr.getmaxyx():
                curses.resizeterm(ts.lines, ts.columns)
                stdscr.clear()  # force a full repaint (avoid stale cells on grow)
        except (curses.error, OSError):
            pass

        # Visible list = base(mode) -> filter by query -> order. Every view
        # flows through the same order_notes() so search and sort compose the
        # same way everywhere. `keep` = the view has its own order that the
        # "relevance" sort should preserve (loops staleness, dup grouping);
        # `natural` is how that order is labelled in the header.
        q = state["q"]
        # Resolve the lazily-loaded trash list up front so its identity is
        # stable in the cache key below (rather than flipping None->list mid-key).
        if state["trash_mode"] and state["_trash"] is None:
            state["_trash"] = load_trash()
            state["_trash_gen"] += 1

        def compute_filtered():
            if state["trash_mode"]:
                base, keep = state["_trash"], False
            elif state["dup_mode"] is not None:
                base, keep = state["dup_mode"], True
            elif state["review_mode"]:
                base, keep = find_loops(notes, state["_review"]), True
            elif state["tagf"] is not None:
                base, keep = filter_by_tags(notes, tagf_active(state["tagf"])), False
            else:
                base, keep = notes, False
            return order_notes(base, state["sort"], state["rev"], q, keep)

        # Rank/filter only when an input that affects the list changes — not on
        # every j/k. id(notes) flips exactly when an incremental reload swaps in
        # a fresh list (it returns the same object when nothing changed), so it
        # is a free generation marker; the rest are the mode, sort and query.
        filter_key = (
            id(notes), state["sort"], state["rev"], q,
            # A generation counter, not id(_trash): the old list is freed
            # (set to None) before the new one is allocated, so id() could
            # collide and serve a stale frame.
            state["trash_mode"], state["_trash_gen"],
            id(state["dup_mode"]), state["review_mode"], id(state["_review"]),
            tuple(tagf_active(state["tagf"])) if state["tagf"] is not None else None,
        )
        filtered = frame_cache(state["_filter_cache"], filter_key, compute_filtered)

        # Restore cursor to a specific note after external reload
        restore_path = state.pop("_restore_path", None)
        if restore_path is not None:
            for i, n in enumerate(filtered):
                if n["path"] == restore_path:
                    state["cur"] = i
                    break
            else:
                state["cur"] = 0

        h, w = stdscr.getmaxyx()
        clamp_scroll(state, filtered, h)

        # An editor/vimdiff launch failed because the program isn't installed:
        # surface it on the bar (the launch was swallowed, not crashed). Checked
        # here, before the draw, so it shows even when the triggering handler
        # ended in `continue` (e.g. creating a note from the search box).
        if launch.missing:
            push_msg(f"can't launch {launch.missing} — check default_editor / tag_editor")
            launch.missing = None

        # The status bar only rotates when its pooled messages can't all fit on
        # one line at the current width; when they fit they're shown whole and
        # statically (no rotation, no fast-poll).
        _pool = state["_msg_pool"]
        rotating = len(_pool) > 1 and disp_width(MSG_JOIN.join(_pool)) > (w - 1)

        # History (the "h/H hist" hint) is a ~100ms `git log --follow`, so don't
        # run it while moving — it would stall j/k. Use the cached count if we
        # have it; otherwise show no hint yet and compute it once we settle (an
        # idle tick below).
        cur_path = filtered[state["cur"]]["path"] if 0 <= state["cur"] < len(filtered) else None
        if cur_path != state["_hist_path"]:
            state["_hist_path"] = cur_path
            set_term_title("notoj: %s" % title(filtered[state["cur"]])
                           if cur_path is not None else "notoj")
            if cur_path in state["_hist_cache"]:
                state["_hist_count"] = state["_hist_cache"][cur_path]
                state["_hist_dirty"] = False
            else:
                state["_hist_count"] = 0
                state["_hist_dirty"] = cur_path is not None

        draw(stdscr, filtered, state)

        # Poll quickly while a history lookup is pending (so the hint appears
        # soon after you stop) or while several status messages are rotating
        # through the bar; otherwise idle at the slow scan cadence.
        stdscr.timeout(120 if state["_hist_dirty"]
                       else (400 if rotating else 2000))
        t_wait = time.monotonic()
        k = stdscr.getch()

        # Dead-terminal guard: when the pty/SSH session dies, getch returns
        # ERR instantly instead of honoring the timeout, which would busy-
        # spin at 100% CPU with no UI attached. A genuine timeout takes
        # >=120ms; a run of instant ERRs means the input is gone — exit.
        if k == -1 and time.monotonic() - t_wait < 0.01:
            state["_eof_spins"] = state.get("_eof_spins", 0) + 1
            if state["_eof_spins"] > 50:
                if 0 <= state["cur"] < len(filtered):
                    save_cursor(filtered[state["cur"]]["path"])
                break
        else:
            state["_eof_spins"] = 0

        # Cross-session undo/redo prompt is armed: this keystroke either
        # confirms (y, or pressing the same undo/redo key again) or cancels
        # (anything else). Either way it is consumed here.
        if state["_xsess_armed"] is not None and k != -1:
            direction, _sess = state["_xsess_armed"]
            state["_xsess_armed"] = None
            clear_msgs()
            if k in (ord("y"), ord("Y")) or key_matches(k, KEY[direction]):
                xsess_step(direction)
            continue

        # Any real keystroke starts a new action: clear the pooled messages from
        # the previous one before this key runs (the armed-prompt case above
        # already returned).
        if k != -1:
            clear_msgs()

        # ----------------------------
        # Quit
        # ----------------------------

        if k == -1:
            # Rotate the status bar to the next pooled message once its beat
            # elapses, wrapping around (only while it can't be shown whole).
            if rotating and time.monotonic() - state["_msg_rot"] >= MSG_ROTATE_SECS:
                state["_msg_idx"] = (state["_msg_idx"] + 1) % len(state["_msg_pool"])
                state["_msg_rot"] = time.monotonic()

            # Settled on a note: now safe to compute its history count (cached).
            if state["_hist_dirty"]:
                state["_hist_dirty"] = False
                cp = state["_hist_path"]
                if cp:
                    rel = os.path.relpath(cp, NOTES_DIR)
                    r = subprocess.run(
                        ["git", "log", "--follow", "-2", "--format=%H", "--", rel],
                        cwd=NOTES_DIR, capture_output=True, text=True
                    )
                    cnt = sum(1 for x in r.stdout.strip().splitlines() if x)
                    state["_hist_cache"][cp] = cnt
                    if cp == state["_hist_path"]:
                        state["_hist_count"] = cnt

            # Scan for external changes / Syncthing conflicts at most every 2s
            # (the adaptive timeout can fire this branch as often as 120ms).
            if time.monotonic() - last_scan >= SCAN_EVERY:
                last_scan = time.monotonic()
                state["_trash"] = None   # pick up external trash changes too
                new_snap = file_snapshot(NOTES_DIR)
                notes, changed = incremental_update(notes, snap, new_snap)
                state["_conflicts"] = find_conflicts()
                if changed:
                    snap = file_snapshot(NOTES_DIR)
                    state["_dups"] = find_duplicates(notes)
                    state["_review"] = load_review()   # inline scheduling may have written it
                    state["_hist_cache"].clear()
                    if state["dup_mode"] is not None:
                        state["dup_mode"] = state["_dups"]
                    cur_path = filtered[state["cur"]]["path"] if 0 <= state["cur"] < len(filtered) else None
                    state["_restore_path"] = cur_path
                    git_commit("sync: external changes")
                # Recompute the due-loop badge on every idle tick, not just on
                # file changes: in a long tmux session a loop can come due
                # purely by time passing.
                state["_loops_due"] = len(find_loops(notes, state["_review"]))

        # ----------------------------
        # Tag prompt mode (intercepts all keys while active)
        # ----------------------------

        elif state["tag_mode"]:
            buf = prompt_buf(state, "tag_input")

            if k in (9, curses.KEY_BTAB):   # Tab / Shift-Tab — cycle tag names
                # A run of Tabs cycles one candidate list; any other key ends
                # the run (the stored text/pos no longer match the buffer), so
                # the next Tab starts a fresh completion from what you typed.
                comp = state.get("_tag_comp")
                if not (comp and comp["text"] == buf.text
                        and comp["pos"] == buf.pos):
                    start = token_start(buf.text, buf.pos)
                    comp = {"cands": tag_completions(buf.text[start:buf.pos]),
                            "i": -1, "text": buf.text, "pos": buf.pos}
                if comp["cands"]:
                    comp["i"] = ((comp["i"] + (1 if k == 9 else -1))
                                 % len(comp["cands"]))
                    buf.text, buf.pos = complete_token(
                        buf.text, buf.pos, comp["cands"][comp["i"]])
                    comp["text"], comp["pos"] = buf.text, buf.pos
                    state["tag_input"] = buf.text
                    refresh_tag_preview(state, buf)
                else:
                    push_msg("no tag matches")
                state["_tag_comp"] = comp
                continue

            r = buf.handle_key(k, stdscr.getch, esc_peek)
            state["tag_input"] = buf.text
            refresh_tag_preview(state, buf)

            if r == "cancel":
                state["tag_mode"] = False
                state["tag_input"] = ""
                state["_tag_preview"] = ""

            elif r == "submit":
                if filtered and 0 <= state["cur"] < len(filtered):
                    note = filtered[state["cur"]]
                    new_tags = parse_tag_input(state["tag_input"])
                    mod_ts = note.get("modificationDate")
                    added = add_tags_keep_date(note["path"], new_tags) if new_tags else []
                    if added:
                        record({"kind": "tags", "path": note["path"],
                                "added": added, "mod": mod_ts})
                        state["_last_tags"] = state["tag_input"].strip()
                        git_commit(f"tag: {_stem(note['path'])}")
                        refresh_notes()
                        state["_restore_path"] = note["path"]
                state["tag_mode"] = False
                state["tag_input"] = ""
                state["_tag_preview"] = ""

            continue

        # ----------------------------
        # Schedule prompt mode (intercepts all keys while active)
        # ----------------------------

        elif state["sched_mode"]:
            buf = prompt_buf(state, "sched_input")
            r = buf.handle_key(k, stdscr.getch, esc_peek)
            state["sched_input"] = buf.text

            if r == "cancel":
                state["sched_mode"] = False
                state["sched_input"] = ""

            elif r == "submit":
                if filtered and 0 <= state["cur"] < len(filtered):
                    note = filtered[state["cur"]]
                    due = parse_when(state["sched_input"])
                    if due is not None:
                        nid = note["id"]
                        before = state["_review"].get(nid)
                        schedule_loop(state["_review"], nid, due)
                        save_review(state["_review"])
                        record({"kind": "defer", "id": nid, "path": note["path"],
                                "before": before, "after": state["_review"][nid]})
                        refresh_notes()
                state["sched_mode"] = False
                state["sched_input"] = ""

            continue

        # ----------------------------
        # Quit
        # ----------------------------

        elif key_matches(k, KEY["quit"]) and not state["search_mode"]:
            if 0 <= state["cur"] < len(filtered):
                save_cursor(filtered[state["cur"]]["path"])
            break

        # ----------------------------
        # Open note
        # ----------------------------

        elif key_matches(k, KEY["open"]) and filtered and not state["search_mode"]:
            open_selected(filtered[state["cur"]])

        elif key_matches(k, KEY["open_end"]) and filtered and not state["search_mode"]:
            open_selected(filtered[state["cur"]], end=True)

        # ----------------------------
        # Incremental search mode
        # ----------------------------

        elif k == 27 and not state["search_mode"] and (state["q"] or state["dup_mode"] is not None or state["trash_mode"] or state["review_mode"] or state["tagf"] is not None):
            cur_path = filtered[state["cur"]]["path"] if 0 <= state["cur"] < len(filtered) else None
            if state["q"]:
                # First ESC: clear the search filter, stay in the current view
                # and fall back to its natural order (relevance with no query).
                state["q"] = ""
                state["qf"] = -1
                state["sort"] = "relevance"
                if cur_path:
                    state["_restore_path"] = cur_path
            else:
                # Second ESC: leave the duplicates / trash / resurface /
                # tag-filter view for the notes list. (Trash paths don't exist
                # there, so don't try to keep the cursor on one.) A tag filter
                # entered from the tags view goes back there instead, with the
                # cursor on the tag it came from.
                was_trash = state["trash_mode"]
                reopen_focus = None
                if state["tagf"] is not None and state["tagf"].get("from_T"):
                    reopen_focus = state["tagf"]["tags"][0]
                state["dup_mode"] = None
                state["trash_mode"] = False
                state["review_mode"] = False
                state["tagf"] = None
                state["sort"] = "relevance"
                if cur_path and not was_trash:
                    state["_restore_path"] = cur_path
                if reopen_focus is not None:
                    sel = tags_view(stdscr, notes, focus=reopen_focus,
                                    ui=state["_tags_ui"])
                    if sel is MODAL_QUIT:
                        if cur_path:
                            save_cursor(cur_path)
                        break
                    if sel:
                        state["tagf"] = {"tags": [sel], "idx": -1, "from_T": True}
                        state.pop("_restore_path", None)
            state["cur"] = 0
            state["off"] = 0
            state["p_scroll"] = 0

        elif state["search_mode"]:
            # All editing lives in EditBuffer (the one editor shared with the
            # modal "/" filters and the tag/schedule prompts); this branch
            # only handles what's search-specific — list-cursor moves and the
            # open-or-create Enter. state["q"]/["q_pos"] stay the source of
            # truth for the rest of the app (draw, order_notes, external
            # resets), mirrored from the buffer after each key. Sync in first,
            # in case q was reset elsewhere since the last keypress.
            buf = prompt_buf(state, "q")

            if k == curses.KEY_DOWN:
                state["cur"] += 1
                state["p_scroll"] = 0
                continue
            if k == curses.KEY_UP:
                state["cur"] -= 1
                state["p_scroll"] = 0
                continue
            if k in (curses.KEY_NPAGE, curses.KEY_PPAGE):
                # Same preview paging as the main list — the EditBuffer has no
                # use for the page keys, so scrolling stays available while
                # you're still typing the query.
                cur_note = (filtered[state["cur"]]
                            if 0 <= state["cur"] < len(filtered) else None)
                preview_scroll_key(k, state, cur_note, w, h)
                continue

            r = buf.handle_key(k, stdscr.getch, esc_peek)
            state["q"] = buf.text
            state["q_pos"] = buf.pos

            if r == "cancel":
                state["search_mode"] = False
            elif r == "changed":
                state["cur"] = 0
                state["off"] = 0
                state["qf"] = -1        # a new query starts on all its terms
            elif r == "submit":
                state["search_mode"] = False
                if filtered:
                    open_selected(filtered[state["cur"]])
                elif state["q"].strip() and not (
                        state["review_mode"] or state["dup_mode"] is not None
                        or state["trash_mode"] or state["tagf"] is not None):
                    # "no match -> create a note from the query" only makes
                    # sense in the plain notes view, not while filtering a
                    # loops / duplicates / trash subset.
                    dest = new_note(state["q"].strip())
                    refresh_notes()
                    state["q"] = ""
                    state["qf"] = -1
                    state["q_pos"] = 0
                    state["cur"] = 0
                    state["off"] = 0
                    state["p_scroll"] = 0
                    if dest:
                        state["_restore_path"] = dest

            continue

        # ----------------------------
        # Enter search mode
        # ----------------------------

        elif key_matches(k, KEY["search"]):
            # `/` filters the current view (notes, trash, duplicates, or loops);
            # it no longer drops you out of the special views. Searching selects
            # the relevance sort (best matches first) until you pick another.
            state["search_mode"] = True
            state["q"] = ""
            state["qf"] = -1
            state["q_pos"] = 0
            state["cur"] = 0
            state["off"] = 0
            state["sort"] = "relevance"

        # ----------------------------
        # Navigation
        # ----------------------------

        elif k in NAV_KEYS:
            d = nav_delta(k, h - 2)
            if d == NAV_BOTTOM:
                state["cur"] = len(filtered) - 1
            elif d == NAV_SCREEN:
                state["cur"] = screen_target(k, state["off"], h - 2,
                                             len(filtered))
            else:
                state["cur"] += d
            state["p_scroll"] = 0
            clamp_scroll(state, filtered, h)

        elif k in CHORD_PREFIXES:
            stdscr.timeout(1000)   # fixed window for the chord's second key
            nxt = stdscr.getch()   # (the loop resets the timeout next iteration)
            act = CHORDS.get((k, nxt))

            if act == "goto_top":
                state["cur"] = 0
                state["off"] = 0
                state["p_scroll"] = 0
                clamp_scroll(state, filtered, h)

            elif act == "dups_view":
                if state["dup_mode"] is not None:
                    state["dup_mode"] = None
                elif state["_dups"]:
                    state["dup_mode"] = state["_dups"]
                state["tagf"] = None
                state["cur"] = 0
                state["off"] = 0
                state["p_scroll"] = 0
                state["sort"] = "relevance"

            elif act == "trash_view":
                state["trash_mode"] = not state["trash_mode"]
                state["_trash"] = None
                state["dup_mode"] = None
                state["review_mode"] = False
                state["tagf"] = None
                state["cur"] = 0
                state["off"] = 0
                state["p_scroll"] = 0
                state["sort"] = "relevance"

            elif act == "hist_diff":
                if filtered:
                    if not open_hist_last(filtered[state["cur"]]):
                        push_msg("no earlier version of this note")
                    refresh_notes()

            elif act == "resurface":
                state["review_mode"] = not state["review_mode"]
                state["dup_mode"] = None
                state["trash_mode"] = False
                state["tagf"] = None
                state["cur"] = 0
                state["off"] = 0
                state["p_scroll"] = 0
                state["sort"] = "relevance"

        # ----------------------------
        # Preview scrolling
        # ----------------------------

        elif k in (curses.KEY_NPAGE, curses.KEY_PPAGE):
            cur_note = (filtered[state["cur"]]
                        if 0 <= state["cur"] < len(filtered) else None)
            preview_scroll_key(k, state, cur_note, w, h)

        # ----------------------------
        # Trash note
        # ----------------------------

        elif key_matches(k, KEY["trash"]) and filtered and not state["trash_mode"]:
            cur = state["cur"]
            note = filtered[cur]
            orig = note["path"]
            dest = trash_note(note)
            record({"kind": "trash", "orig": orig, "trash": dest})
            refresh_notes()
            state["cur"] = cur
            state["p_scroll"] = 0

        # ----------------------------
        # Resurface actions: snooze / mark done
        # ----------------------------

        elif key_matches(k, KEY["snooze"]) and state["review_mode"] and filtered:
            note = filtered[state["cur"]]
            nid = note["id"]
            before = state["_review"].get(nid)
            snooze_loop(state["_review"], nid)
            save_review(state["_review"])
            record({"kind": "defer", "id": nid, "path": note["path"],
                    "before": before, "after": state["_review"][nid]})
            refresh_notes()
            state["p_scroll"] = 0

        elif key_matches(k, KEY["schedule"]) and state["review_mode"] and filtered:
            state["sched_mode"] = True
            state["sched_input"] = ""

        elif key_matches(k, KEY["loop_done"]) and state["review_mode"] and filtered:
            note = filtered[state["cur"]]
            mod_ts = note.get("modificationDate")
            if remove_tag(note["path"], LOOP_TAG):
                git_commit(f"close loop: {title(note)}")
                record({"kind": "loop", "path": note["path"], "mod": mod_ts})
                refresh_notes()
            state["p_scroll"] = 0

        # ----------------------------
        # Tag note ( # to enter tags, . to repeat last addition )
        # ----------------------------

        elif key_matches(k, KEY["tag"]) and filtered and not state["trash_mode"]:
            state["tag_mode"] = True
            state["tag_input"] = ""
            state["_tag_comp"] = None
            state["_tag_preview"] = ""

        elif key_matches(k, KEY["tag_repeat"]) and filtered and state["_last_tags"] and not state["trash_mode"]:
            note = filtered[state["cur"]]
            new_tags = parse_tag_input(state["_last_tags"])
            mod_ts = note.get("modificationDate")
            added = add_tags_keep_date(note["path"], new_tags) if new_tags else []
            if added:
                record({"kind": "tags", "path": note["path"],
                        "added": added, "mod": mod_ts})
                git_commit(f"tag: {_stem(note['path'])}")
                refresh_notes()
                state["_restore_path"] = note["path"]
                state["p_scroll"] = 0

        # ----------------------------
        # Tag filter ( t = notes sharing the selected note's tags, ⇥ cycles
        # all -> each single tag; T = browse all tags )
        # ----------------------------

        elif key_matches(k, KEY["tag_filter"]) and filtered and not state["trash_mode"]:
            note = filtered[state["cur"]]
            ntags = list(note.get("tags") or [])
            if ntags:
                state["tagf"] = {"tags": ntags, "idx": -1}
                state["dup_mode"] = None
                state["review_mode"] = False
                state["sort"] = "relevance"
                state["q"] = ""
                state["qf"] = -1
                state["cur"] = 0
                state["off"] = 0
                state["p_scroll"] = 0
                # The source note matches its own tag set, so keep it selected.
                state["_restore_path"] = note["path"]

        elif k in (9, curses.KEY_BTAB):
            # Tab cycles a filter: which tag the view is narrowed to, or which
            # search term n/N steps through — the same all → each → all walk.
            # Where both are available, tab_in_tag_view says which gets the
            # unshifted key and the other takes Shift-Tab.
            terms = search_tokens(state["q"])
            in_tagf = state["tagf"] is not None
            tags_first = in_tagf and not tab_cycles_terms_in_tag_view()
            wants_tags = in_tagf and ((k == 9) == tags_first)
            if wants_tags:
                tf = state["tagf"]
                tf["idx"] = tf["idx"] + 1 if tf["idx"] + 1 < len(tf["tags"]) else -1
                cur_path = filtered[state["cur"]]["path"] if 0 <= state["cur"] < len(filtered) else None
                state["cur"] = 0
                state["off"] = 0
                state["p_scroll"] = 0
                if cur_path:
                    state["_restore_path"] = cur_path   # keep selection if it still matches
            elif not cycle_term(state, terms, 1 if k == 9 else -1):
                push_msg("one search term — nothing to cycle" if terms
                         else "no search — / first")

        elif key_matches(k, KEY["help"]):
            if help_view(stdscr) is MODAL_QUIT:
                if filtered and 0 <= state["cur"] < len(filtered):
                    save_cursor(filtered[state["cur"]]["path"])
                break

        elif key_matches(k, KEY["backlinks"]) and filtered and not state["trash_mode"]:
            sel = backlinks_view(stdscr, notes, filtered[state["cur"]])
            if sel is MODAL_QUIT:
                if 0 <= state["cur"] < len(filtered):
                    save_cursor(filtered[state["cur"]]["path"])
                break
            if sel:
                # Jump to the chosen note in the plain notes list (it may not
                # be visible in the current view/filter).
                state["dup_mode"] = None
                state["review_mode"] = False
                state["trash_mode"] = False
                state["tagf"] = None
                state["q"] = ""
                state["qf"] = -1
                state["sort"] = "relevance"
                state["cur"] = 0
                state["off"] = 0
                state["p_scroll"] = 0
                state["_restore_path"] = sel

        elif key_matches(k, KEY["tag_browse"]) and not state["trash_mode"]:
            sel = tags_view(stdscr, notes, ui=state["_tags_ui"])
            if sel is MODAL_QUIT:
                if filtered and 0 <= state["cur"] < len(filtered):
                    save_cursor(filtered[state["cur"]]["path"])
                break
            if sel:
                # from_T: ESC from this filter goes back to the tags view
                # (cursor on the tag) rather than to the notes list.
                state["tagf"] = {"tags": [sel], "idx": -1, "from_T": True}
                state["dup_mode"] = None
                state["review_mode"] = False
                state["sort"] = "relevance"
                state["q"] = ""
                state["qf"] = -1
                state["cur"] = 0
                state["off"] = 0
                state["p_scroll"] = 0

        # ----------------------------
        # Sort mode
        # ----------------------------

        elif key_matches(k, KEY["sort"]):
            if state["sort"] in SORTS:
                idx = SORTS.index(state["sort"])
                state["sort"] = SORTS[(idx + 1) % len(SORTS)]
            else:  # leaving the default "relevance" sort
                state["sort"] = SORTS[0]

        # reverse sort
        elif key_matches(k, KEY["sort_reverse"]):
            state["rev"] = not state["rev"]

        # undo: reverse most-recent recorded action (trash, loop-close, edit,
        # tag, or defer — snooze/schedule)
        elif key_matches(k, KEY["undo"]):
            if state["trash_mode"] and filtered and 0 <= state["cur"] < len(filtered):
                restore_note(filtered[state["cur"]])
                refresh_notes()
                state["cur"] = max(0, state["cur"] - 1)
            elif state["_undo"]:
                nxt = state["_undo"][-1]
                foreign = nxt.get("sess") and nxt["sess"] != SESSION_ID
                # _xsess_armed is always None here — an armed keystroke is
                # consumed (and disarmed) by the prompt block before dispatch.
                if foreign:
                    xsess_arm("undo", nxt["sess"])
                else:
                    undo_step()
            elif not state["trash_mode"]:
                push_msg("nothing to undo")

        # redo: re-apply most-recently-undone action (Ctrl-R by default)
        elif key_matches(k, KEY["redo"]):
            if state["_redo"]:
                nxt = state["_redo"][-1]
                foreign = nxt.get("sess") and nxt["sess"] != SESSION_ID
                if foreign:
                    xsess_arm("redo", nxt["sess"])
                else:
                    redo_step()
            else:
                push_msg("nothing to redo")

        # next / previous search match in the preview pane (n/N, as in Vim —
        # which is also what n/N do once Enter opens the note there)
        elif key_matches(k, KEY["match_next"]) or key_matches(k, KEY["match_prev"]):
            cur_note = filtered[state["cur"]] if 0 <= state["cur"] < len(filtered) else None
            step = 1 if key_matches(k, KEY["match_next"]) else -1
            toks = highlight_tokens(cur_note, search_tokens(state["q"]), state)
            if not match_step(state, cur_note, toks, w, h, step):
                push_msg("no matches to step through" if state["q"]
                         else "no search — / first")

        # new note
        elif key_matches(k, KEY["new"]):
            dest = new_note()
            refresh_notes()
            state["cur"] = 0
            state["off"] = 0
            state["p_scroll"] = 0
            if dest:
                state["_restore_path"] = dest

        # resolve conflict
        elif key_matches(k, KEY["conflict"]):
            conflicts = find_conflicts()
            if conflicts:
                original, conflict = conflicts[0]
                resolve_conflict(original, conflict)
                refresh_notes()
            else:
                push_msg("no conflicts to resolve")

        # history
        elif key_matches(k, KEY["hist_browse"]) and filtered:
            hist_view(stdscr, filtered[state["cur"]])
            refresh_notes()


def load_notes_dir():
    v = config_get("notes_dir")
    return os.path.expanduser(v) if v else None


def save_notes_dir(path):
    global _config_cache
    os.makedirs(os.path.dirname(CONFIG_FILE), exist_ok=True)
    # Preserve any other config lines (e.g. tag_editor.* rules); only replace
    # the notes_dir line.
    lines = []
    try:
        with open(CONFIG_FILE, "r", encoding="utf-8") as f:
            lines = [ln for ln in f if not ln.strip().startswith("notes_dir=")]
    except FileNotFoundError:
        pass
    if lines and not lines[-1].endswith("\n"):
        lines[-1] += "\n"
    lines.append(f"notes_dir={path}\n")
    with open(CONFIG_FILE, "w", encoding="utf-8") as f:
        f.writelines(lines)
    _config_cache = None   # written file differs from any cached parse


def prompt_notes_dir(current=None):
    default = current or os.path.expanduser("~/notes")
    if current:
        print(f"notoj: notes directory not found: {current}")
    else:
        print("notoj: no notes directory configured.")
    while True:
        print(f"Notes directory [{default}]: ", end="", flush=True)
        ans = input().strip()
        path = os.path.expanduser(ans if ans else default)
        if os.path.isdir(path):
            return path
        print(f"  '{path}' does not exist. Create it? [y/N] ", end="", flush=True)
        if input().strip().lower() == "y":
            os.makedirs(path)
            return path


def offer_simplenote_import(notes_dir):
    if glob.glob(os.path.join(notes_dir, "*.md")):
        return

    script = os.path.join(SCRIPT_DIR, "simplenote_convert_to_md.py")
    if not os.path.exists(script):
        return

    print("Notes directory is empty. Import from a Simplenote export? [y/N] ", end="", flush=True)
    if input().strip().lower() != "y":
        return

    print("Path to Simplenote export directory: ", end="", flush=True)
    export_dir = os.path.expanduser(input().strip())
    if not os.path.isdir(export_dir):
        print(f"  '{export_dir}' not found, skipping import.")
        return

    subprocess.run([sys.executable, script, export_dir, notes_dir])


if __name__ == "__main__":
    # Honor the user's locale so curses decodes/encodes UTF-8: without this,
    # multibyte input (Arabic, accents, emoji) and output are mishandled.
    locale.setlocale(locale.LC_ALL, "")

    if len(sys.argv) > 1 and sys.argv[1] in ("-h", "--help"):
        print(HELP)
        sys.exit(0)

    if len(sys.argv) > 1 and sys.argv[1] == "--version":
        print(f"notoj {VERSION}")
        sys.exit(0)

    # Validate CLI imports up here, while there is still a terminal to print an
    # error to — the copy itself happens inside run(), once git is initialized.
    try:
        IMPORTS, MOVE, VERSION_FLAG = parse_import_args(sys.argv[1:])
    except ValueError as e:
        print(f"notoj: {e}", file=sys.stderr)
        sys.exit(2)

    saved = load_notes_dir()
    if saved and os.path.isdir(saved):
        NOTES_DIR = saved
    else:
        NOTES_DIR = prompt_notes_dir(saved)
        save_notes_dir(NOTES_DIR)

    TRASH_DIR = os.path.join(NOTES_DIR, ".trash")
    STATE_FILE = os.path.join(NOTES_DIR, ".notoj_state")
    REVIEW_FILE = os.path.join(NOTES_DIR, ".notoj_review.json")
    os.environ["NOTOJ_NOTES_DIR"] = NOTES_DIR

    # Undo journal: local to this machine (NEVER the synced tree), keyed by
    # notes dir; session id stamps each persisted action with its origin.
    UNDO_LOG = undo_log_path()
    SESSION_ID = f"{os.getpid()}-{int(time.time())}"
    if config_bool("undo.persist", True):
        try:
            os.makedirs(os.path.dirname(UNDO_LOG), exist_ok=True)
        except OSError:
            pass

    offer_simplenote_import(NOTES_DIR)

    try:
        curses.wrapper(run, IMPORTS, MOVE)
    finally:
        set_cursor_style(0)  # don't leave a blinking block in the shell
        set_term_title("")   # give the title back to the shell
        log_event({"t": "session", "ev": "quit", "sess": SESSION_ID})
