def get_note_commits(path):
    rel = os.path.relpath(path, NOTES_DIR)
    r = subprocess.run(
        ["git", "log", "--follow", "--format=%H\t%at\t%s", "--", rel],
        cwd=NOTES_DIR, capture_output=True, text=True
    )
    commits = []
    for line in r.stdout.strip().splitlines():
        if "\t" not in line:
            continue
        h, ts, msg = line.split("\t", 2)
        commits.append({"hash": h, "ts": float(ts), "msg": msg})
    return commits


def get_diff_lines(path, commit_hash):
    rel = os.path.relpath(path, NOTES_DIR)
    r = subprocess.run(
        ["git", "diff", commit_hash, "--", rel],
        cwd=NOTES_DIR, capture_output=True, text=True
    )
    return r.stdout.splitlines()


def open_vimdiff_at(path, commit_hash):
    rel = os.path.relpath(path, NOTES_DIR)
    r = subprocess.run(
        ["git", "show", f"{commit_hash}:{rel}"],
        cwd=NOTES_DIR, capture_output=True, text=True
    )
    if r.returncode != 0:
        return
    with tempfile.NamedTemporaryFile(mode="w", suffix=".md", delete=False, encoding="utf-8") as f:
        f.write(r.stdout)
        tmp = f.name
    try:
        suspend_curses()
        launch(["vimdiff", tmp, path])
    finally:
        os.unlink(tmp)


def open_hist_last(n):
    rel = os.path.relpath(n["path"], NOTES_DIR)
    r = subprocess.run(
        ["git", "log", "--follow", "-2", "--format=%H", "--", rel],
        cwd=NOTES_DIR, capture_output=True, text=True
    )
    hashes = [h for h in r.stdout.strip().splitlines() if h]
    if len(hashes) < 2:
        return False
    open_vimdiff_at(n["path"], hashes[1])
    return True


MODAL_QUIT = object()
# Sentinel returned through a modal's on_key: the user pressed q — quit the
# whole app, like q everywhere else (ESC is the "back" key inside modals).


def modal_list(stdscr, view):
    """Run a modal list screen — the chrome shared by the history, tags,
    backlinks, and help views: erase, narrow-window bail, underlined header
    row, left list with the cursor row reversed, optional divider + right
    preview pane, footer band, and a blocking key loop speaking the shared
    nav vocabulary (nav_delta / clamp_list / gg).

    `view` is a dict of callbacks/settings:
      count()                            -> number of list rows
      header(w) / footer()               -> bar texts
      draw_row(scr, y, i, selected, lw)  -> draw row i at screen row y
      draw_preview(scr, x0, pw, ph, cur) -> right pane (omit for full-width)
      on_key(k, st) -> None to keep looping, or a 1-tuple (result,) to close
      on_move(st)                        -> selection changed (nav or gg)
      cur                                -> initial cursor index (default 0)
      search                             -> {"items": fn, "match": fn}: give
                                            the view a "/" filter (see below)
      preview_lines(sel)                 -> total line count of the preview
                                            for original index `sel`; when
                                            present the scaffold owns PgDn/
                                            PgUp preview scrolling (offset in
                                            st["p_off"], step from the
                                            preview_scroll config, reset on
                                            selection change, passed to
                                            draw_preview as its last arg)

    st is {"cur", "off", "page_h", "sel"}; on_key may move the cursor through
    it. st["sel"] is the selected index into the view's ORIGINAL list — equal
    to st["cur"] normally, mapped through the filter while a "/" search is
    narrowing the rows. Views index their data with st["sel"], never st["cur"].
    Returns the value from on_key's closing tuple.

    "/" search: when view["search"] is present, the scaffold owns the whole
    lifecycle — "/" opens an EditBuffer, printable keys narrow the rows live
    (match(item, lowercased_query) over items()), the header gains "/query
    (n)", bare ESC clears the filter (it never exits the view), and Enter is
    forwarded to on_key with st["sel"] valid so the view's select action
    works unchanged on a filtered list. Full readline editing comes with the
    buffer. Adding search to a view is one dict entry. Searchable views'
    draw_row receives the lowercased live query as an extra trailing arg
    ("" outside search) so rows can highlight the match."""
    st = {"cur": view.get("cur", 0), "off": 0, "page_h": 1, "sel": 0,
          "p_off": 0}
    on_key = view["on_key"]
    search = view.get("search")
    preview_lines = view.get("preview_lines")
    sq = None     # EditBuffer while the "/" filter is open, else None
    idx = None    # filtered positions into search["items"]() (None = no filter)

    def peek():
        # ESC follow-up byte for EditBuffer's Alt chords: a real Alt-key sends
        # ESC and the letter back-to-back, so it's already buffered; look with
        # a short window. The main loop resets the timeout each iteration.
        stdscr.timeout(25)
        nxt = stdscr.getch()
        stdscr.timeout(500)
        return nxt

    def count_f():
        return len(idx) if idx is not None else view["count"]()

    def orig(i):
        return idx[i] if idx is not None else i

    def refilter():
        nonlocal idx
        idx = filter_indices(search["items"](), search["match"], sq.text)
    eof_spins = 0
    # Tick twice a second rather than blocking: a resize is only guaranteed
    # to be noticed by the size poll below (SIGWINCH may surface as
    # KEY_RESIZE, as ERR, or not wake a blocked getch at all, depending on
    # the terminal). An idle tick stays inside the input wait below and
    # redraws nothing, so it costs ~0.
    stdscr.timeout(500)

    while True:
        # Pick up resizes even when the SIGWINCH surfaced as ERR instead of
        # KEY_RESIZE (tmux): poll the real size, like the main loop does —
        # otherwise getmaxyx() stays stale and nothing reflows until cells
        # happen to change. clear() forces a full repaint at the new size.
        try:
            ts = os.get_terminal_size()
            if (ts.lines, ts.columns) != stdscr.getmaxyx():
                curses.resizeterm(ts.lines, ts.columns)
                stdscr.clear()
                if sq is not None:
                    refilter()  # items() may rebuild for the new width (help)
        except (curses.error, OSError):
            pass

        stdscr.erase()
        h, w = stdscr.getmaxyx()

        # Same narrow-window bail as draw(): below this the pane widths go
        # nonsensical and addnstr would error out. Keys still reach on_key,
        # so the view's exit keys keep working while squeezed.
        narrow = h < 5 or w < MIN_W_ERROR
        if narrow:
            addnstr_w(stdscr, 0, 0, "window too narrow", max(1, w - 1))
        else:
            page_h = st["page_h"] = h - 2   # rows 1..h-2; footer bar at h-1
            n_rows = count_f()
            # Per-frame clamp: covers the initial cursor, on_key cursor
            # moves, shrinking lists, and terminal resizes in one place.
            clamp_list(st, n_rows, page_h)
            st["sel"] = orig(st["cur"]) if n_rows else 0
            list_w = min(38, w // 3) if view.get("draw_preview") else w - 1

            try:
                stdscr.hline(0, 0, ord(" ") | curses.A_UNDERLINE, w)
            except curses.error:
                pass
            head = view["header"](w)
            q_col = None
            q_x = None
            if sq is not None:
                # Query field starts after 'header  /'; columns by display
                # width so wide glyphs in the header (note titles) don't
                # skew the cursor or the accent overdraw.
                q_x = disp_width(head) + 3
                q_col = min(q_x + sq.pos, w - 2)
                head += f"  /{sq.text}  ({n_rows})"
            addnstr_w(stdscr, 0, 0, head, w - 1,
                      curses.A_BOLD | curses.A_UNDERLINE)
            if sq is not None and q_x < w - 1:
                # The query itself in the accent color, like the main
                # filter bar's value.
                addnstr_w(stdscr, 0, q_x, sq.text, w - 1 - q_x,
                          curses.color_pair(1)
                          | curses.A_BOLD | curses.A_UNDERLINE)

            ql = sq.text.lower() if sq is not None else ""
            for i in range(st["off"], min(n_rows, st["off"] + page_h)):
                if search is not None:
                    view["draw_row"](stdscr, i - st["off"] + 1, orig(i),
                                     i == st["cur"], list_w, ql)
                else:
                    view["draw_row"](stdscr, i - st["off"] + 1, orig(i),
                                     i == st["cur"], list_w)

            if view.get("draw_preview") and (idx is None or idx):
                for y in range(1, h - 1):
                    stdscr.addch(y, list_w, curses.ACS_VLINE)
                if preview_lines:
                    view["draw_preview"](stdscr, list_w + 1, w - list_w - 2,
                                         page_h, st["sel"], st["p_off"])
                else:
                    view["draw_preview"](stdscr, list_w + 1, w - list_w - 2,
                                         page_h, st["sel"])

            try:
                stdscr.hline(h - 1, 0, ord(" ") | footer_attr(), w)
            except curses.error:
                pass
            foot = ("type to filter  ⮐ select  ESC clear search"
                    if sq is not None else view["footer"]())
            addnstr_w(stdscr, h - 1, 0, foot, w - 1, footer_attr())

            if q_col is not None:
                show_input_cursor(stdscr, q_col)
            else:
                hide_input_cursor(stdscr)

        stdscr.refresh()

        # Wait for input here across idle ticks — a `continue` would rebuild
        # the whole frame, so the 2 Hz tick must not take that path. Only a
        # real key, a resize (KEY_RESIZE, or a size change after an ERR —
        # tmux surfaces SIGWINCH that way), or the dead-pty guard leaves
        # this wait.
        while True:
            t_wait = time.monotonic()
            k = stdscr.getch()
            if k != -1:
                eof_spins = 0
                break
            # A *dead* terminal (closed pty, dropped SSH) yields ERR
            # instantly, ignoring the timeout — which would busy-spin at
            # 100% CPU. A run of instant ERRs means the input is gone:
            # unwind; the main loop's matching guard then exits the app.
            if time.monotonic() - t_wait < 0.01:
                eof_spins += 1
                if eof_spins > 50:
                    return None
                continue
            eof_spins = 0
            try:
                ts = os.get_terminal_size()
                if (ts.lines, ts.columns) != stdscr.getmaxyx():
                    break          # resize surfaced as ERR: redraw
            except (curses.error, OSError):
                pass
        if k in (-1, curses.KEY_RESIZE):
            if k == curses.KEY_RESIZE and sq is not None:
                refilter()  # row list may rebuild at the new width (help)
            continue               # redraw at the new size

        # Scaffold "/" search: open on "/", then the EditBuffer sees every key
        # before nav/on_key — j/k are letters to type while filtering. Keys
        # the buffer doesn't own (Up/Down, PgUp/PgDn) fall through to nav so
        # the list (and any preview) stays driveable mid-search.
        if not narrow and search is not None:
            if sq is None:
                if k == ord("/"):
                    sq = EditBuffer()
                    refilter()
                    st["cur"] = st["off"] = 0
                    continue
            else:
                prev_sel = st["sel"]

                def moved_to_top():
                    # A filter change lands the cursor on a (possibly) new
                    # item; state-based previews (history's diff) reload via
                    # on_move, exactly as a nav move would.
                    st["cur"] = st["off"] = st["p_off"] = 0
                    st["sel"] = orig(0) if count_f() else 0
                    if st["sel"] != prev_sel and count_f() and view.get("on_move"):
                        view["on_move"](st)

                r = sq.handle_key(k, stdscr.getch, peek)
                if r == "cancel":       # bare ESC — clear filter, keep view
                    sq = None
                    idx = None
                    moved_to_top()
                    continue
                if r == "changed":
                    refilter()
                    moved_to_top()
                    continue
                if r == "moved":
                    continue
                if r == "submit":       # Enter — view's select, filtered-aware
                    if count_f():
                        st["sel"] = orig(st["cur"])
                        res = on_key(10, st)
                        if res is not None:
                            return res[0]
                    continue
                # r is None: not an editing key — fall through to nav below.

        # Scaffold preview scrolling: PgDn/PgUp page the preview pane (step
        # from the preview_scroll config), clamped to its content. Works
        # mid-search too — these keys fall through the EditBuffer above.
        if not narrow and preview_lines and k in (curses.KEY_NPAGE,
                                                  curses.KEY_PPAGE):
            total = preview_lines(st["sel"]) if count_f() else 0
            step = preview_scroll_step(st["page_h"])
            if k == curses.KEY_NPAGE:
                st["p_off"] = min(st["p_off"] + step,
                                  max(0, total - st["page_h"]))
            else:
                st["p_off"] = max(0, st["p_off"] - step)
            continue

        # While the "/" filter is open, j/k/G/g/h/m/l are letters (the
        # EditBuffer consumed them above if printable); only non-typable nav
        # keys move.
        cap = sq is not None
        nav_ok = (NAV_KEYS - {ord("j"), ord("k"), ord("G")} - SCREEN_KEYS
                  if cap else NAV_KEYS)
        if not narrow and (k in nav_ok or (k == ord("g") and not cap)):
            prev = st["cur"]
            if k == ord("g"):
                k2 = stdscr.getch()
                if k2 == ord("g"):
                    st["cur"] = 0
                elif k2 != -1:
                    curses.ungetch(k2)  # not a chord: let it dispatch normally
            else:
                d = nav_delta(k, st["page_h"])
                if d == NAV_BOTTOM:
                    st["cur"] = count_f() - 1
                elif d == NAV_SCREEN:
                    st["cur"] = screen_target(k, st["off"], st["page_h"],
                                              count_f())
                else:
                    st["cur"] += d
            clamp_list(st, count_f(), st["page_h"])
            st["sel"] = orig(st["cur"]) if count_f() else 0
            if st["cur"] != prev:
                st["p_off"] = 0
                if view.get("on_move"):
                    view["on_move"](st)
        else:
            # While searching, only keys the EditBuffer declined get here —
            # function keys like PgUp/PgDn (hist diff scroll) work mid-filter.
            r = on_key(k, st)
            if r is not None:
                return r[0]


def hist_view(stdscr, n):
    commits = get_note_commits(n["path"])
    if not commits:
        return

    vs = {"diff": []}

    def load_diff(cur):
        vs["diff"] = get_diff_lines(n["path"], commits[cur]["hash"])
        # The rows are keyed by the selected commit, but the diff behind a
        # given index can also change under a "/" refilter — drop them.
        prev.invalidate()

    prev = PreviewRows(lambda _sel: vs["diff"])

    def diff_attr(line):
        if line.startswith("+") and not line.startswith("+++"):
            return curses.color_pair(3)
        if line.startswith("-") and not line.startswith("---"):
            return curses.color_pair(2)
        if line.startswith("@@"):
            return curses.color_pair(4)
        return curses.A_NORMAL

    load_diff(0)

    def draw_row(scr, y, i, selected, list_w, q=""):
        c = commits[i]
        base = curses.A_REVERSE if selected else 0
        date_str = datetime.fromtimestamp(c["ts"]).strftime("%m-%d %H:%M")
        # Commit date through the same recency gradient as the notes list:
        # fresh edits warm, old ones fading to grey.
        addnstr_w(scr, y, 0, date_str, list_w - 1,
                  date_attr(c["ts"], datetime.now().timestamp()) | base)
        dw = disp_width(date_str) + 1
        if dw < list_w - 1:
            draw_line_highlighted(
                scr, y, dw, c["msg"], list_w - 1 - dw,
                curses.color_pair(1) | curses.A_BOLD | base,
                Hi([q] if q else [], match_attr() | base))

    def draw_preview(scr, x0, pw, ph, cur, off):
        diff = vs["diff"]
        if not diff:
            addnstr_w(scr, 1, x0, "(no changes vs current)", pw, curses.A_DIM)
            return
        for i, (line, src, _) in enumerate(prev.rows(cur, pw)[off:off + ph]):
            addnstr_w(scr, i + 1, x0, line, pw, diff_attr(diff[src]))

    def on_key(k, st):
        if k in [ord("q"), 27]:
            return (None,)
        if k in (10, 13):
            open_vimdiff_at(n["path"], commits[st["sel"]]["hash"])
            stdscr.refresh()
        return None

    def match(c, ql):
        date_str = datetime.fromtimestamp(c["ts"]).strftime("%m-%d %H:%M")
        return ql in c["msg"].lower() or ql in date_str

    modal_list(stdscr, {
        "count": lambda: len(commits),
        "search": {"items": lambda: commits, "match": match},
        # Rows, not source lines: with wrap on, a long diff line is several
        # rows and PgDn must page past all of them.
        "preview_lines": prev.count,
        "header": lambda w: f"history: {title(n)}",
        "footer": lambda: ("j/k select  / search  PgDn/PgUp scroll diff  "
                           "⮐ vimdiff  q back"),
        "draw_row": draw_row,
        "draw_preview": draw_preview,
        "on_key": on_key,
        "on_move": lambda st: load_diff(st["sel"]),   # one git show per move
    })


def tags_view(stdscr, notes, focus=None, ui=None):
    """Full-screen browser of every tag (T): count, name, and how recently a
    note carrying it was touched. s cycles the sort (recent → count → name);
    recent is the default, and `ui` (a dict) persists the chosen mode across
    visits. `focus` preselects a tag (used when ESC from a tag filter jumps
    back here). Enter returns the chosen tag name (the caller filters the
    notes list on it); ESC returns None (back); q returns MODAL_QUIT."""
    stats = tag_stats(notes)
    if not stats:
        return None
    vs = {"mode_i": (ui or {}).get("mode_i", 0)}
    vs["items"] = sort_tag_stats(stats, TAG_SORTS[vs["mode_i"]])
    count_w = max((len(str(c)) for c, _ in stats.values()), default=1)
    cur0 = 0
    if focus is not None:
        for i, it in enumerate(vs["items"]):
            if it[0] == focus:
                cur0 = i
                break

    def draw_row(scr, y, i, selected, list_w, q=""):
        tag, count, last = vs["items"][i]
        base = curses.A_REVERSE if selected else 0
        draw_line_highlighted(
            scr, y, 0, f"{count:>{count_w}}  #{tag}  ({ago(last)})",
            list_w - 1, curses.color_pair(3) | base,
            Hi([q] if q else [], match_attr() | base))

    def tagged_for(sel):
        # Filtering every note by the selected tag is too costly to redo on
        # each j/k; it only changes when the selection does.
        sel_tag = vs["items"][sel][0]
        return frame_cache(
            vs.setdefault("_prev", {}), sel_tag,
            lambda: sort_notes(filter_by_tags(notes, [sel_tag]), "modified", True))

    prev = PreviewRows(lambda sel: [title(m) for m in tagged_for(sel)])

    def draw_preview(scr, x0, pw, ph, cur, off):
        # A miniature notes list: same title color and date recency gradient
        # as the main list, so the pane reads as "these notes".
        now_ts = datetime.now().timestamp()
        tagged = tagged_for(cur)
        for i, (t, src, last) in enumerate(prev.rows(cur, pw)[off:off + ph]):
            addnstr_w(scr, i + 1, x0, t, pw, curses.color_pair(1))
            # The date trails the title's *final* row, so a wrapped title
            # keeps its date instead of colliding with its continuation.
            tw = disp_width(t) + 2
            if last and tw < pw:
                ts = tagged[src].get("modificationDate")
                addnstr_w(scr, i + 1, x0 + tw, f"({ago(ts)})", pw - tw,
                          date_attr(ts, now_ts))

    def on_key(k, st):
        if k == 27:
            return (None,)
        if k == ord("q"):
            return (MODAL_QUIT,)
        if k == ord("s"):
            sel = vs["items"][st["sel"]][0] if vs["items"] else None
            vs["mode_i"] = (vs["mode_i"] + 1) % len(TAG_SORTS)
            if ui is not None:
                ui["mode_i"] = vs["mode_i"]
            vs["items"] = sort_tag_stats(stats, TAG_SORTS[vs["mode_i"]])
            prev.invalidate()   # the rows are keyed by index; the order moved
            # Keep the selection on the same tag across the re-sort; the
            # scaffold's per-frame clamp re-centers the scroll window.
            for i, it in enumerate(vs["items"]):
                if it[0] == sel:
                    st["cur"] = i
                    break
        elif k in (10, 13):
            if vs["items"]:
                return (vs["items"][st["sel"]][0],)
        return None

    return modal_list(stdscr, {
        "cur": cur0,
        "count": lambda: len(vs["items"]),
        "search": {"items": lambda: vs["items"],
                   "match": lambda it, ql: ql in it[0].lower()},
        "preview_lines": prev.count,
        "header": lambda w: (f"tags ({len(vs['items'])})  "
                             f"sort:{TAG_SORTS[vs['mode_i']]}"),
        "footer": lambda: ("j/k select  / search  s sort  "
                           "⮐ filter notes by tag  ESC back  q quit"),
        "draw_row": draw_row,
        "draw_preview": draw_preview,
        "on_key": on_key,
    })


def backlinks_view(stdscr, notes, note):
    """Notes linking to `note` (b): [[wikilinks]] and [text](target) links,
    the ones Vim's gf follows. The preview shows the referencing lines with
    the source title highlighted. Enter returns the chosen note's path (the
    caller jumps there); ESC returns None (back); q returns MODAL_QUIT."""
    links = find_backlinks(notes, note)
    fname = os.path.basename(note["path"])
    hi_token = title(note).lower()
    prev_cache = {}   # memoizes the preview scan across redraws (see frame_cache)

    def draw_row(scr, y, i, selected, list_w, q=""):
        m = links[i]
        attr = curses.color_pair(1)
        base = curses.A_REVERSE if selected else 0
        t = title(m)
        draw_line_highlighted(scr, y, 0, t, list_w - 1, attr | base,
                              Hi([q] if q else [], match_attr() | base))
        tw = disp_width(t) + 2
        if tw < list_w - 1:
            ts = m.get("modificationDate")
            addnstr_w(scr, y, tw, f"({ago(ts)})", list_w - 1 - tw,
                      date_attr(ts, datetime.now().timestamp()) | base)

    def hits_for(sel):
        # Scanning the source note for referencing lines only changes with the
        # selection, so cache it rather than re-scan on every scroll step.
        return frame_cache(prev_cache, sel,
                           lambda: linking_lines(content(links[sel]), fname))

    # Hits are stripped before wrapping: a referencing line is usually indented
    # body text, and keeping that indent would waste pane width on every row.
    prev = PreviewRows(lambda sel: [ln.strip() for ln in hits_for(sel)])

    def draw_preview(scr, x0, pw, ph, cur, off):
        if not links:
            addnstr_w(scr, 1, x0, "(no notes link to this one)", pw, curses.A_DIM)
            return
        for i, (line, _, _) in enumerate(prev.rows(cur, pw)[off:off + ph]):
            draw_line_highlighted(
                scr, i + 1, x0, line, pw, curses.color_pair(4),
                Hi([hi_token] if hi_token else [], match_attr()))

    def on_key(k, st):
        if k == 27:
            return (None,)
        if k == ord("q"):
            return (MODAL_QUIT,)
        if k in (10, 13) and links:
            return (links[st["sel"]]["path"],)
        return None

    return modal_list(stdscr, {
        "count": lambda: len(links),
        "search": {"items": lambda: links,
                   "match": lambda m, ql: ql in title(m).lower()},
        "preview_lines": lambda sel: prev.count(sel) if links else 0,
        "header": lambda w: f"backlinks: {title(note)} ({len(links)})",
        "footer": lambda: "j/k select  / search  ⮐ go to note  ESC back  q quit",
        "draw_row": draw_row,
        "draw_preview": draw_preview,
        "on_key": on_key,
    })


def help_rows(width):
    """KEYMAP flattened for the ? overlay: (kind, key, text) rows — section
    headers, key entries (wrapped to `width`, continuation lines carry an
    empty key), and blank separators between sections."""
    key_w = _help_key_w()
    desc_w = max(20, width - 2 - key_w - 1)
    rows = []
    for section, entries in KEYMAP:
        if rows:
            rows.append(("blank", "", ""))
        rows.append(("section", "", section))
        for action, key, desc in entries:
            label = action_label(action, key) if action else key
            for j, part in enumerate(textwrap.wrap(desc, desc_w)):
                rows.append(("entry", label if j == 0 else "", part))
    rows.append(("blank", "", ""))
    for part in textwrap.wrap("Key remapping and other configuration "
                              f"settings at {CONFIG_FILE}", max(20, width - 1)):
        rows.append(("section", "", part))
    return rows


def _help_key_w():
    """Width of the key column in the help screens, using effective bindings."""
    return max(disp_width(action_label(a, k) if a else k)
               for _, entries in KEYMAP for a, k, _ in entries) + 3


def help_view(stdscr):
    """In-app key reference (?): KEYMAP in a scrollable full-width overlay,
    keys colored apart from their meanings, descriptions wrapped to the live
    terminal width. Nav keys scroll, "/" searches the entries (key labels and
    descriptions; section headers drop out while filtering), ? toggles the
    overlay closed (ESC too), q quits. A trailer line points at the config
    file for remapping."""
    key_w = _help_key_w()
    vs = {"w": None, "rows": []}

    def rows_now():
        # Rebuilt whenever the width changes (count() runs every frame, so a
        # KEY_RESIZE rewraps before the next draw).
        w = stdscr.getmaxyx()[1]
        if w != vs["w"]:
            vs["w"] = w
            vs["rows"] = help_rows(w)
        return vs["rows"]

    def draw_row(scr, y, i, selected, list_w, q=""):
        rows = rows_now()
        if i >= len(rows):
            return
        kind, key, text = rows[i]
        if kind == "blank":
            return
        base = curses.A_REVERSE if selected else 0
        hi = Hi([q] if q else [], match_attr() | base)
        if kind == "section":
            addnstr_w(scr, y, 0, text, list_w - 1, curses.A_BOLD | base)
        else:
            # Pad the key field by display width so wide keys (←/→, ↑/↓, ⌫)
            # don't shove the description column out of alignment.
            key_field = key + " " * max(0, key_w - disp_width(key))
            draw_line_highlighted(scr, y, 2, key_field, max(1, list_w - 3),
                                  curses.color_pair(3) | base, hi)
            draw_line_highlighted(scr, y, 2 + key_w, text,
                                  max(1, list_w - 3 - key_w), base, hi)

    return modal_list(stdscr, {
        "count": lambda: len(rows_now()),
        "search": {"items": rows_now,
                   # Only key entries are searchable; section headers and
                   # blank separators drop out of a filtered list.
                   "match": lambda r, ql: r[0] == "entry" and (
                       ql in r[1].lower() or ql in r[2].lower())},
        "header": lambda w: "notoj keys",
        "footer": lambda: "j/k scroll  / search  ?/ESC close  q quit",
        "draw_row": draw_row,
        # q quits the app (like everywhere); the key that opened the overlay
        # ("?") toggles it closed, as does ESC. Enter is a no-op — it means
        # "select" in every other view, and there's nothing to select here.
        "on_key": lambda k, st: ((MODAL_QUIT,) if k == ord("q")
                                 else (None,) if k in (27, ord("?")) else None),
    })


# ----------------------------
# Conflict detection / resolution
# ----------------------------

CONFLICT_RE = re.compile(r'^(.+)\.sync-conflict-[\d]+-[\d]+-[A-Z0-9]+(\.[^.]+)$')


def find_conflicts():
    """Return list of (original_path, conflict_path) pairs for Syncthing conflicts, oldest first.
    Scans NOTES_DIR recursively (including .trash) so conflicts in subdirectories aren't missed;
    skips .git and .stversions internals. The cron conflict sentinel covers other synced folders."""
    results = []
    for dirpath, dirnames, filenames in os.walk(NOTES_DIR):
        dirnames[:] = [d for d in dirnames if d not in (".git", ".stversions")]
        for fn in filenames:
            if not fn.endswith(".md"):
                continue
            m = CONFLICT_RE.match(fn)
            if m:
                conflict = os.path.join(dirpath, fn)
                original = os.path.join(dirpath, m.group(1) + m.group(2))
                results.append((original, conflict))
    return sorted(results, key=lambda t: t[1])


def resolve_conflict(original, conflict):
    # Snapshot the conflict copy into git history first: the copy is deleted
    # below regardless of what was (or wasn't) merged in vimdiff, and conflict
    # files never enter the regular snapshot commits, so without this an
    # accidental :qa would lose that version forever. -f because copies under
    # .trash/ are gitignored.
    rel = os.path.relpath(conflict, NOTES_DIR)
    subprocess.run(["git", "add", "-f", "--", rel], cwd=NOTES_DIR, capture_output=True)
    subprocess.run(["git", "commit", "-m", f"conflict copy: {_stem(conflict)}"],
                   cwd=NOTES_DIR, capture_output=True)
    suspend_curses()
    if os.path.exists(original):
        if not launch(["vimdiff", original, conflict]):
            return   # editor missing — leave both files for a later retry
    else:
        if not launch(vim_cmd() + [conflict]):
            return
        if os.path.exists(conflict):
            os.rename(conflict, original)
            conflict = None
    if conflict and os.path.exists(conflict):
        os.remove(conflict)
    stem = os.path.splitext(os.path.basename(original))[0]
    git_commit(f"resolve: {stem}")


# ----------------------------
# Actions
# ----------------------------

def check_rename(n):
    """After a content edit through notoj: bump the modified date, increment the
    version (edit counter), and rename the file if the first line changed.

    Version is incremented only here — on a local content save — so it stays a
    coherent edit count across devices: normalize_external_note preserves an
    incoming version (the editing device already bumped it), avoiding double
    counts when Syncthing delivers a change."""
    path = n["path"]
    if not os.path.exists(path):
        return

    try:
        with open(path, "r", encoding="utf-8") as f:
            text = f.read()
    except Exception:
        return

    if not text.startswith("---\n"):
        return

    fm_end = text.find("\n---\n", 4)
    if fm_end == -1:
        return

    meta = parse_frontmatter(text[4:fm_end])
    body = text[fm_end + 5:]
    if body.startswith("\n"):
        body = body[1:]

    new_first_line = derive_title(body)

    title_changed = bool(new_first_line) and new_first_line != (meta.get("title") or "")
    now_iso = datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")

    new_yaml_lines = []
    title_written = False
    for line in text[4:fm_end].splitlines():
        if line.startswith("title:") and title_changed:
            new_yaml_lines.append(f"title: {yaml_scalar(new_first_line)}")
            title_written = True
        elif line.startswith("modified:"):
            new_yaml_lines.append(f"modified: {now_iso}")
        elif line.startswith("version:"):
            try:
                v = int(line.split(":", 1)[1].strip()) + 1
            except ValueError:
                v = 1
            new_yaml_lines.append(f"version: {v}")
        else:
            new_yaml_lines.append(line)
            if line.startswith("id:") and title_changed and not title_written:
                new_yaml_lines.append(f"title: {yaml_scalar(new_first_line)}")
                title_written = True

    new_text = "---\n" + "\n".join(new_yaml_lines) + text[fm_end:]

    if title_changed:
        new_stem = slugify(new_first_line)
        new_path = unique_dest(new_stem + ".md", keep=path)
    else:
        new_path = path

    atomic_write(path, new_text)

    if new_path != path:
        os.rename(path, new_path)

    sync_hashtags(new_path)
    schedule_inline_loop(new_path)
    return new_path


# Vimscript sourced into the Vim sessions notoj spawns. In markdown buffers it:
#   - makes gf follow [[wikilinks]] and [text](target) links to other notes in
#     $NOTOJ_NOTES_DIR, falling back to built-in gf otherwise;
#   - highlights [[wikilinks]] (notojWikiLink, linked to Underlined);
#   - exposes NotojOpenAtTitle() to open a note at its title line.
# Embedded here (rather than shipped as a sibling file) so notoj stays a single
# self-contained program.
NOTOJ_VIM_SCRIPT = r"""
function! s:NotojEdit(name) abort
  let l:dir = $NOTOJ_NOTES_DIR
  if empty(l:dir)
    return 0
  endif
  let l:name = substitute(a:name, '^\s*\(.\{-}\)\s*$', '\1', '')
  let l:name = substitute(l:name, '^<\(.*\)>$', '\1', '')
  if empty(l:name)
    return 0
  endif
  if l:name !~? '\.md$'
    let l:name .= '.md'
  endif
  execute 'edit' fnameescape(l:dir . '/' . l:name)
  return 1
endfunction

function! s:NotojSpan(line, cur, pat) abort
  let l:start = 0
  while l:start <= len(a:line)
    let l:m = matchstrpos(a:line, a:pat, l:start)
    if l:m[1] < 0
      return []
    endif
    if a:cur >= l:m[1] && a:cur < l:m[2]
      return l:m
    endif
    let l:start = l:m[2] > l:m[1] ? l:m[2] : l:m[1] + 1
  endwhile
  return []
endfunction

function! NotojFollow() abort
  let l:line = getline('.')
  let l:cur = col('.') - 1

  let l:m = s:NotojSpan(l:line, l:cur, '\[\[[^][]*\]\]')
  if !empty(l:m)
    let l:name = substitute(l:m[0], '^\[\[\(.*\)\]\]$', '\1', '')
    if s:NotojEdit(l:name)
      return
    endif
  endif

  let l:m = s:NotojSpan(l:line, l:cur, '\[[^][]*\]([^()]*)')
  if !empty(l:m)
    let l:name = substitute(l:m[0], '^\[[^][]*\](\(.*\))$', '\1', '')
    if s:NotojEdit(l:name)
      return
    endif
  endif

  silent! normal! gf
endfunction

" Line number of the title: first non-blank line after the frontmatter block.
function! s:NotojTitleLine() abort
  let l:last = line('$')
  let l:start = 1
  if getline(1) ==# '---'
    let l:i = 2
    while l:i <= l:last
      if getline(l:i) ==# '---'
        let l:start = l:i + 1
        break
      endif
      let l:i += 1
    endwhile
  endif
  let l:i = l:start
  while l:i <= l:last
    if getline(l:i) !~# '^\s*$'
      return l:i
    endif
    let l:i += 1
  endwhile
  return l:start
endfunction

" Put the cursor on the title line, and if the body fills the window, pin that
" line to the top so the frontmatter scrolls off screen.
function! NotojOpenAtTitle() abort
  let l:tl = s:NotojTitleLine()
  call cursor(l:tl, 1)
  if line('$') - l:tl + 1 >= winheight(0)
    let l:v = winsaveview()
    let l:v.topline = l:tl
    call winrestview(l:v)
  endif
endfunction

function! s:NotojSetup() abort
  if !empty($NOTOJ_NOTES_DIR)
    let &l:path = $NOTOJ_NOTES_DIR
  endif
  nnoremap <buffer> <silent> gf :call NotojFollow()<CR>
  if !exists('w:notoj_wikilink_match')
    let w:notoj_wikilink_match = matchadd('notojWikiLink', '\[\[[^][]*\]\]')
  endif
endfunction

highlight default link notojWikiLink Underlined

augroup notoj_follow
  autocmd!
  autocmd FileType markdown call s:NotojSetup()
  autocmd ColorScheme * highlight default link notojWikiLink Underlined
augroup END

if &filetype ==# 'markdown'
  call s:NotojSetup()
endif
"""

_vim_helper_path = None


def load_tag_editors():
    """{tag: command} from `tag_editor.<tag> = <command>` config lines, letting
    a note open in a custom editor/terminal based on its tags. Example:

        tag_editor.arabic = mlvim

    opens any note tagged `arabic` in mlterm (where Arabic letters connect
    cursively — gnome-terminal/VTE can't, it locks every glyph to a fixed
    cell). The mapped command receives the usual vim args (sourced helper,
    cursor position, file path) appended, so it must be a vim launcher that
    forwards "$@" to vim."""
    editors = {}
    for key, val in _read_config().items():
        if key.startswith("tag_editor.") and val:
            tag = key[len("tag_editor."):].strip().lower()
            if tag:
                editors[tag] = val
    return editors


def is_vimlike(cmd):
    """Whether the editor command takes Vim's `-c` args. notoj appends Vim-only
    options (sourcing the gf helper, cursor placement, startinsert); a non-Vim
    editor (emacs/gedit/nano) would mistake those for filenames, so they're
    only added for Vim-family editors. mlvim matches via the substring."""
    if not cmd:
        return False
    base = os.path.basename(cmd[0]).lower()
    return "vim" in base or base in ("vi", "view", "ex", "nvi")


def vim_cmd(note=None):
    """Editor command for a spawned session, resolved in order: a `tag_editor`
    entry matching one of the note's tags (e.g. `arabic` -> `mlvim`), then
    $NOTOJ_VIM, then the `default_editor` config, then plain `vim`. shlex-split
    so multi-word commands work."""
    if note is not None:
        editors = load_tag_editors()
        if editors:
            for tag in (note.get("tags") or []):
                cmd = editors.get(str(tag).strip().lower())
                if cmd:
                    return shlex.split(cmd)
    return shlex.split(os.environ.get("NOTOJ_VIM", "").strip()
                       or config_get("default_editor", "").strip()
                       or "vim")


def vim_source_args():
    """Materialize the embedded notoj vimscript to a temp file (once per run)
    and return the -c args that source it, giving spawned Vim sessions
    note-link gf support."""
    global _vim_helper_path
    if _vim_helper_path is None:
        fd, path = tempfile.mkstemp(prefix="notoj-", suffix=".vim")
        with os.fdopen(fd, "w", encoding="utf-8") as f:
            f.write(NOTOJ_VIM_SCRIPT)
        _vim_helper_path = path
        atexit.register(lambda p=path: os.path.exists(p) and os.remove(p))
    esc = _vim_helper_path.replace("\\", "\\\\").replace(" ", "\\ ")
    return ["-c", "source " + esc]


def vim_search_scope():
    """What Vim is told to search when Tab has narrowed navigation to one term
    (`vim_search_scope`):

      term   (default) Vim gets that term alone, so its `n`/`N` cycle exactly
             what notoj's were cycling a keystroke ago.
      query  Vim gets the whole query — every term stays highlighted and
             reachable there — and the narrowed term only places the cursor.
    """
    v = (config_get("vim_search_scope", "term") or "term").strip().lower()
    return "query" if v == "query" else "term"


def tab_cycles_terms_in_tag_view():
    """Whether Tab cycles search terms rather than tags inside a tag-filter
    view, where both could be cycled (`tab_in_tag_view`). Either way the other
    one is on Shift-Tab, so nothing is unreachable — this only picks which gets
    the unshifted key. Defaults to tags, the older meaning."""
    v = (config_get("tab_in_tag_view", "tags") or "tags").strip().lower()
    return v == "terms"


def vim_search_pattern(q, extra=()):
    """Translate a notoj search query into a Vim search pattern, so opening a
    matched note can highlight the hits and drop the cursor on the first one.
    Mirrors rank_notes: a quoted phrase stays contiguous with any whitespace
    between its words (\\s\\+), while a token query ORs its terms so `n` cycles
    through every hit. Built in \\V ("very nomagic") so the typed text is taken
    literally — only backslashes need doubling — with a leading \\c for
    case-insensitivity. Returns None when there's nothing to search for.

    `extra` holds the words a token only *nearly* matched in this note — the
    corrected spellings. They're ORed in as alternatives because the typed
    query appears nowhere in such a file: without them Vim highlights nothing,
    `n` reports no matches, and the cursor falls back to the title. A quoted
    phrase is exact by definition, so nothing is added to one."""
    q = (q or "").strip()
    if not q:
        return None
    lit = lambda s: s.replace("\\", "\\\\")
    if q.startswith('"') and q.endswith('"') and len(q) > 2:
        words = q[1:-1].split()
        if not words:
            return None
        # \_s (not \s) so the gap can span a line break, matching how the
        # quoted-phrase search joins the note's running text in rank_notes.
        body = r"\_s\+".join(lit(w) for w in words)
    else:
        toks = q.split() + [e for e in extra if e]
        if not toks:
            return None
        body = r"\|".join(lit(t) for t in toks)
    return r"\c\V" + body


def _vim_position_args(src, end, search, at=None, at_pat=None):
    """The -c args that place the cursor (and, with an active search, highlight
    the matches) for a spawned Vim.

    `search` is always wired in with `let @/` rather than `/pat`/`+/pat`: notoj
    ranks fuzzily (edit distance, tag and substring hits), so a note can rank
    for a query it doesn't contain verbatim. `let @/` sets the pattern (so `n`
    and 'hlsearch' use *this* query, never a stale one) without the E486 that a
    failed `/pat` would raise. Positioning: the last line (end), else `at` —
    the (1-based file line, ordinal-on-that-line) of the match the preview was
    focused on, so opening at the 3rd hit enters Vim on the 3rd hit — else the
    first literal match via the quiet search(), falling back to the title when
    the note has no verbatim hit, else the title. `src` flags that the notoj
    vimscript (with NotojOpenAtTitle) was sourced."""
    args = []
    if search:
        args += ["-c", "let @/ = '%s'" % search.replace("'", "''"),
                 "-c", "set hlsearch"]
    if end:
        args += ["-c", "normal G"]
    elif search:
        # search() (unlike /pat or `normal n`) is silent when there's no match,
        # so a fuzzy-only hit won't beep or error — it just keeps the fallback.
        if at:
            line, ordinal = at
            # From the top of the target line, take the first match at or after
            # it, then step over the earlier hits on that same line. One -c
            # holding the loop, not one -c per step: Vim caps a command line at
            # ten -c arguments, so a line with a dozen hits would have blown
            # past it. 'W' (no wrap) means running out of matches just leaves
            # the cursor on the last one instead of looping back to the top of
            # the file.
            # Positioning normally goes by @/ itself. `at_pat` overrides it so
            # the cursor can be placed by a narrower pattern than the one
            # 'hlsearch' is lighting up — that's vim_search_scope=query, where
            # Vim shows every term but opens on the one Tab singled out.
            pat = ("'%s'" % at_pat.replace("'", "''")) if at_pat else "@/"
            args += ["-c", "silent! keepjumps call cursor(%d, 1) | "
                           "silent! call search(%s, 'cW') | "
                           "for _ in range(%d) | silent! call search(%s, 'W') "
                           "| endfor" % (line, pat, ordinal, pat)]
        else:
            jump = "silent! keepjumps call cursor(1, 1) | if search(@/, 'cw') == 0"
            jump += " | call NotojOpenAtTitle() | endif" if src else " | endif"
            args += ["-c", jump]
    elif src:
        args += ["-c", "call NotojOpenAtTitle()"]
    return args


def edit_in_editor(n, end, search, at=None, at_pat=None):
    """Suspend curses and open the note in the configured editor, positioned
    by `end`/`search`/`at`. True when the file was written (its mtime moved); a
    missing editor or a quit without writing is False. The one launch
    preamble behind open_note and edit_trash_note."""
    path = n["path"]
    try:
        mtime_before = os.path.getmtime(path)
    except OSError:
        mtime_before = None
    ed = vim_cmd(n)
    cmd = list(ed)
    if is_vimlike(ed):
        src = vim_source_args()
        cmd += src + _vim_position_args(src, end, search, at, at_pat)
    cmd.append(path)
    suspend_curses()
    launch(cmd)   # a missing editor leaves mtime unchanged → False
    try:
        return os.path.getmtime(path) != mtime_before
    except OSError:
        return False


def open_note(n, end=False, search=None, at=None, at_pat=None):
    path = n["path"]
    before = None
    if os.path.exists(path):
        try:
            with open(path, "r", encoding="utf-8") as f:
                before = f.read()
        except Exception:
            before = None
    if edit_in_editor(n, end, search, at, at_pat):
        final = check_rename(n) or path
        git_commit(f"edit: {title(n)}")
        if before is not None and os.path.exists(final):
            try:
                with open(final, "r", encoding="utf-8") as f:
                    after = f.read()
            except Exception:
                after = None
            if after is not None and after != before:
                try:
                    mtime = os.path.getmtime(final)
                except OSError:
                    mtime = None
                return {"kind": "edit", "path": final, "before": before,
                        "after": after, "mtime": mtime}
    return None


def edit_trash_note(n, end=False, search=None, at=None, at_pat=None):
    """Open a trashed note in Vim. Any saved change restores the note from the
    trash into the notes dir (then the usual title-rename pipeline runs);
    quitting Vim without writing leaves it in the trash. Returns the restored
    path, or None when the note stayed trashed."""
    path = n["path"]
    if not os.path.exists(path):
        return None
    if not edit_in_editor(n, end, search, at, at_pat):
        return None
    restored = do_restore(path, os.path.join(NOTES_DIR, os.path.basename(path)))
    if not restored:
        return None
    final = check_rename({"path": restored}) or restored
    git_commit(f"edit: {title(n)}")
    return final



def _stem(path):
    return os.path.splitext(os.path.basename(path))[0]


def do_trash(path):
    """Move a note file into the trash, returning its trash path."""
    os.makedirs(TRASH_DIR, exist_ok=True)
    dest = unique_dest(os.path.basename(path), TRASH_DIR)
    os.rename(path, dest)
    git_commit(f"trash: {_stem(path)}")
    return dest


def do_restore(trash_path, orig_path):
    """Move a trashed file back, preferring its original path, returning the
    path it landed at."""
    if not os.path.exists(trash_path):
        return None
    dest = unique_dest(os.path.basename(orig_path),
                       os.path.dirname(orig_path) or NOTES_DIR)
    os.rename(trash_path, dest)
    git_commit(f"restore: {_stem(dest)}")
    return dest


def trash_note(n):
    return do_trash(n["path"])


def rename_to_title(path):
    """Rename a note file so its name matches its title's slug. Undo/redo of
    an edit rewrites the content from history, which can leave the filename
    carrying the other version's title; this re-syncs them. Returns the
    resulting path (the input path when the name already agrees)."""
    n = load_md(path)
    if not n:
        return path
    stem = slugify(title(n))
    d = os.path.dirname(path) or "."
    candidate = os.path.join(d, stem + ".md")
    i = 2
    while True:
        if os.path.abspath(candidate) == os.path.abspath(path):
            return path
        if not os.path.exists(candidate):
            break
        candidate = os.path.join(d, f"{stem} ({i}).md")
        i += 1
    os.rename(path, candidate)
    return candidate


# An external edit (another machine over Syncthing, Markor on the phone) bumps
# the file's mtime; notoj's own post-edit normalization preserves it (os.utime).
# So an mtime drift beyond a second means the note changed under a stored edit
# act — replaying it would clobber that newer content, so we skip instead. The
# guard errs toward skipping: a false skip just declines an undo, never
# overwrites. Edit acts only; trash/loop/tags/defer apply safely as-is.
STALE_EPS = 1.0   # seconds; absorbs the sub-second mtime truncation a normalize


def _edit_stale(act):
    if act.get("mtime") is None:
        return False
    try:
        return abs(os.path.getmtime(act["path"]) - act["mtime"]) > STALE_EPS
    except OSError:
        return True   # file gone — can't apply the edit


def undo_action(act, review=None):
    """Reverse a recorded destructive action (mutating act with live paths so a
    later redo stays consistent). Returns the path to focus afterward, or the
    STALE sentinel when an edit's note changed underneath it.

    `review` is the live resurface dict; it is required to undo a "defer" action
    — snooze (z) or schedule (S) — (other kinds ignore it)."""
    kind = act["kind"]
    if kind == "defer":
        if review is not None:
            # Restore the prior resurface state: a missing "before" means the
            # loop had no review entry, so undo removes the one defer added.
            if act.get("before") is None:
                review.pop(act["id"], None)
            else:
                review[act["id"]] = act["before"]
            save_review(review)
        return act.get("path")
    if kind == "trash":
        restored = do_restore(act["trash"], act["orig"])
        if restored:
            act["orig"] = restored
        return restored
    if kind == "loop":
        if reopen_loop(act["path"], act.get("mod")):
            git_commit(f"reopen loop: {_stem(act['path'])}")
        return act["path"]
    if kind == "edit":
        if _edit_stale(act):
            return STALE
        atomic_write(act["path"], act["before"])
        act["path"] = rename_to_title(act["path"])
        try:
            act["mtime"] = os.path.getmtime(act["path"])
        except OSError:
            pass
        git_commit(f"undo edit: {_stem(act['path'])}")
        return act["path"]
    if kind == "tags":
        if remove_tags_frontmatter(act["path"], act["added"]):
            # Tagging bumped the modified date (via the normalize pass);
            # restore the original mtime so undo rolls that back too.
            if act.get("mod"):
                try:
                    os.utime(act["path"], (act["mod"], act["mod"]))
                except OSError:
                    pass
            git_commit(f"untag: {_stem(act['path'])}")
        return act["path"]
    return None


def redo_action(act, review=None):
    """Re-apply a previously undone action. Returns the path to focus, or None
    when the action hides the note (a re-trash).

    `review` is the live resurface dict; it is required to redo a "defer" action
    — snooze (z) or schedule (S) — (other kinds ignore it)."""
    kind = act["kind"]
    if kind == "defer":
        if review is not None:
            review[act["id"]] = act["after"]
            save_review(review)
        return act.get("path")
    if kind == "trash":
        act["trash"] = do_trash(act["orig"])
        return None
    if kind == "loop":
        if remove_tag(act["path"], LOOP_TAG):
            git_commit(f"close loop: {_stem(act['path'])}")
        return act["path"]
    if kind == "edit":
        if _edit_stale(act):
            return STALE
        atomic_write(act["path"], act["after"])
        act["path"] = rename_to_title(act["path"])
        try:
            act["mtime"] = os.path.getmtime(act["path"])
        except OSError:
            pass
        git_commit(f"redo edit: {_stem(act['path'])}")
        return act["path"]
    if kind == "tags":
        if add_tags_keep_date(act["path"], act["added"]):
            git_commit(f"retag: {_stem(act['path'])}")
        return act["path"]
    return None


def load_trash():
    notes = []
    for f in glob.glob(os.path.join(TRASH_DIR, "*.md")):
        n = load_md(f)
        if n:
            notes.append(n)
    return notes


def unique_dest(name, directory=None, keep=None):
    """A free path in `directory` (default NOTES_DIR) for a file called
    `name`, suffixing " (2)", " (3)", … on collision. `keep` is a path whose
    own existence is not a collision — the file being renamed, so a rename
    that lands on itself (e.g. a case-only title change on a case-insensitive
    filesystem) doesn't earn a suffix. Never overwrites an existing note.
    The one collision-suffix implementation — every rename/trash/restore/new
    path goes through here."""
    d = directory or NOTES_DIR
    keep = os.path.abspath(keep) if keep else None
    dest = os.path.join(d, name)
    stem, ext = os.path.splitext(name)
    i = 2
    while os.path.exists(dest) and os.path.abspath(dest) != keep:
        dest = os.path.join(d, f"{stem} ({i}){ext}")
        i += 1
    return dest


def restore_note(n):
    """Restore a trashed note into the vault root (the trash view's `u`) —
    the one collision-handling implementation lives in do_restore."""
    do_restore(n["path"], os.path.join(NOTES_DIR, os.path.basename(n["path"])))


def finalize_new_note(tmp_path):
    try:
        with open(tmp_path, "r", encoding="utf-8") as f:
            text = f.read()
    except FileNotFoundError:
        return None

    if not text.startswith("---\n"):
        os.unlink(tmp_path)
        return None

    fm_end = text.find("\n---\n", 4)
    if fm_end == -1:
        os.unlink(tmp_path)
        return None

    body = text[fm_end + 5:]
    if body.startswith("\n"):
        body = body[1:]

    first_line = derive_title(body)

    if not first_line:
        os.unlink(tmp_path)
        return None

    # Rewrite frontmatter: insert title: after id:, update modified:
    now_iso = datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")
    new_yaml_lines = []
    for line in text[4:fm_end].splitlines():
        if line.startswith("modified:"):
            new_yaml_lines.append(f"modified: {now_iso}")
        else:
            new_yaml_lines.append(line)
            if line.startswith("id:"):
                new_yaml_lines.append(f"title: {yaml_scalar(first_line)}")

    new_text = "---\n" + "\n".join(new_yaml_lines) + text[fm_end:]

    dest = unique_dest(slugify(first_line) + ".md")

    with open(tmp_path, "w", encoding="utf-8") as f:
        f.write(new_text)
    os.rename(tmp_path, dest)
    sync_hashtags(dest)
    schedule_inline_loop(dest)
    git_commit(f"add: {first_line}")
    return dest


IMPORT_EXTS = (".md", ".markdown")


def parse_import_args(argv):
    """Split argv into (files to import, move flag). Raises ValueError with a
    user-facing message if a flag is unknown or a file can't be imported — the
    caller reports it while there is still a terminal, before curses starts."""
    move, paths = False, []
    version = False
    for a in argv:
        if a == "--move":
            move = True
        elif a == "--version":
            version = True
        elif a.startswith("-") and a != "-":
            raise ValueError(f"unknown option: {a}")
        else:
            paths.append(os.path.abspath(os.path.expanduser(a)))

    if move and not paths:
        raise ValueError("--move needs a file to import")

    notes_dir = load_notes_dir()
    notes_dir = os.path.abspath(os.path.expanduser(notes_dir)) if notes_dir else ""
    for p in paths:
        if not os.path.isfile(p):
            raise ValueError(f"not a file: {p}")
        if os.path.splitext(p)[1].lower() not in IMPORT_EXTS:
            raise ValueError(f"not a markdown file: {p}")
        if move and notes_dir and os.path.dirname(p) == notes_dir:
            # There is nothing to move — it is already where notes live.
            raise ValueError(f"--move: already a note: {p}")
    return paths, move, version


def append_origin_footer(dest, src, move):
    """Append a provenance line to the vault copy — where the note came from
    and what happened to the original — so an imported note records its source.
    Preserves mtime: created:/modified: are derived from it downstream, and the
    stamp must not read as a fresh external edit. Skipped (not fatal) if the
    file can't be read as UTF-8."""
    line = (f"moved from {src}" if move
            else f"copied from {src}, original untouched")
    try:
        with open(dest, "r", encoding="utf-8") as f:
            text = f.read()
        if text and not text.endswith("\n"):
            text += "\n"
        st = os.stat(dest)
        atomic_write(dest, f"{text}\n{line}\n")
        os.utime(dest, (st.st_atime, st.st_mtime))
    except Exception:
        pass


def import_file(src, move=False):
    """Copy an outside markdown file into the vault and adopt it: canonicalize
    encoding/line endings, stamp an origin footer, backfill frontmatter, derive
    the title and rename to its slug, sync body hashtags, commit. Returns the
    note's FINAL path (which is not the path it was copied to — adoption
    renames it), or None on failure.

    copy2 carries the source mtime across, so created:/modified: say when the
    file was really written rather than when it was imported — the same contract
    a note gets when it arrives in the notes dir over Syncthing. With move=True
    the original is removed once the vault copy is committed."""
    dest = unique_dest(os.path.basename(src))
    try:
        shutil.copy2(src, dest)
    except OSError:
        return None

    ensure_canonical(dest)
    append_origin_footer(dest, src, move)
    ensure_frontmatter(dest)
    ensure_id(dest)
    final = normalize_external_note(dest) or dest
    git_commit(f"import: {os.path.basename(final)}")

    if move:
        try:
            os.remove(src)
        except OSError:
            pass   # the copy is committed; a stuck original is not worth failing
    return final


def import_msgs(imported, failed):
    """Status-bar lines for a command-line import: what landed (by its adopted
    name, which the title rename may have changed) and what didn't."""
    msgs = []
    if len(imported) == 1:
        msgs.append(f"imported {os.path.basename(imported[0])}")
    elif imported:
        msgs.append(f"imported {len(imported)} files")
    msgs.extend(f"could not import {os.path.basename(s)}" for s in failed)
    return msgs


def new_note(title_text=""):
    """Open the editor on a fresh frontmatter stub — seeded with `title_text`
    as the first body line when given — and adopt the result into the vault."""
    now_iso = datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")
    key = uuid.uuid4().hex
    frontmatter = (
        f"---\n"
        f"id: {key}\n"
        f"created: {now_iso}\n"
        f"modified: {now_iso}\n"
        f"version: 1\n"
        f"tags: []\n"
        f"---\n"
    )
    body = "\n" + (title_text + "\n\n" if title_text else "")
    tmp_path = os.path.join(NOTES_DIR, f".new_{key}.md")
    with open(tmp_path, "w", encoding="utf-8") as f:
        f.write(frontmatter + body)

    suspend_curses()
    ed = vim_cmd()
    cmd = list(ed)
    if is_vimlike(ed):
        cmd += vim_source_args() + ["-c", "normal G", "-c", "startinsert"]
    cmd.append(tmp_path)
    if not launch(cmd):
        try:
            os.remove(tmp_path)   # editor missing — don't leave a stub note
        except OSError:
            pass
        return None
    return finalize_new_note(tmp_path)


