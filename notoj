HELP_KEY_W = 12   # description column starts at 4 (indent) + this


def build_help(width=None):
    """The --help text, rendered from KEYMAP; long descriptions wrap to the
    terminal width with continuation lines under the description column."""
    if width is None:
        width = shutil.get_terminal_size((80, 24)).columns
    desc_w = max(20, width - 4 - HELP_KEY_W)
    lines = [f"notoj {VERSION} — keyboard-driven terminal notes", "",
             "Usage: notoj [--help] [--version] [--move] [FILE.md ...]", ""]
    opt_w = 10
    for label, desc in (
        ("FILE.md", "copy the file into the notes dir, adopt it as a note "
                    "(frontmatter, title, tags), record where it was copied "
                    "from in a footer line, and start with it selected; a "
                    "file already in the notes dir is just selected; "
                    "repeatable, and the first one is the one selected"),
        ("--move", "remove each source file once its copy is committed"),
        ("--version", "print the notoj version and exit"),
    ):
        first, *rest = textwrap.wrap(desc, max(20, width - 2 - opt_w))
        lines.append(f"  {label:<{opt_w}}{first}")
        lines.extend(f"  {'':<{opt_w}}{r}" for r in rest)
    lines += ["", "Keybindings:"]
    for section, entries in KEYMAP:
        lines.append(f"  {section}")
        for action, key, desc in entries:
            label = action_label(action, key) if action else key
            first, *rest = textwrap.wrap(desc, desc_w)
            lines.append(f"    {label:<{HELP_KEY_W}}{first}")
            lines.extend(f"    {'':<{HELP_KEY_W}}{r}" for r in rest)
        lines.append("")
    lines.append("Notes live in the directory set in ~/.config/notoj/config.")
    return "\n".join(lines) + "\n"


