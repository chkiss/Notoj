# notoj config — copy to ~/.config/notoj/config and uncomment what you want.
# Simple `key = value` lines. Blank lines and lines starting with '#' are
# ignored. Booleans accept true/false/yes/no/on/off/1/0.
#
# notes_dir is set for you on first run (notoj prompts and saves it). Every
# other setting below is OPTIONAL and shown with its default.

# Where notes live (normally written by notoj on first run).
# notes_dir=~/notes

# ===========================================================================
# Editor
# ===========================================================================
# Editor for opening/creating notes. Resolution order: a matching tag_editor
# rule, then $NOTOJ_VIM, then default_editor, then plain `vim`. The file path
# is appended; vim-family editors (vim/nvim/gvim/mlvim/vi) also receive
# notoj's gf note-link helper + cursor args, other editors get only the path.
#   default_editor = vim
#   default_editor = nvim
#   default_editor = emacs -nw            # terminal emacs (evil-mode via your init)
#   default_editor = gedit --new-window -w  # GUI; --new-window -w opens a
#                                         # separate window and blocks so the
#                                         # edit is captured (else picked up on
#                                         # the next 2s external-change scan)
# default_editor=vim

# Per-tag editor override: notes carrying <tag> open with <command>.
# Format: tag_editor.<tag> = <command>  (command must forward "$@" to/accept a
# file path). Use this to give a script its own editor/terminal:
#
#   tag_editor.arabic = mlvim             # mlterm window where Arabic letters
#                                         # connect cursively. gnome-terminal/
#                                         # VTE can't — it locks every glyph to
#                                         # a fixed cell — so Arabic-script
#                                         # notes route to mlterm (mlvim wrapper
#                                         # ships in ~/.local/bin).
#
# Complex scripts need full text shaping — reordering, conjuncts, or cursive
# joining — that a terminal cell-grid can't do. Route those per-tag to a
# HarfBuzz-backed GUI editor (gvim keeps your vim keys, -f blocks; gedit is
# plain). Scripts that need this:
#   - Indic: Devanagari, Bengali, Gurmukhi, Gujarati, Odia, Tamil, Telugu,
#            Kannada, Malayalam, Sinhala
#   - Khmer, Burmese (Myanmar), Tibetan
#   - non-Arabic cursive: Syriac, N'Ko, Thaana, Mandaic
# (Arabic itself is handled above via mlterm. You also need a font for the
# script installed, e.g. Noto Sans <Script>.) One rule per tag you use:
#   tag_editor.hindi  = gvim -f
#   tag_editor.khmer  = gedit --new-window -w
#   tag_editor.syriac = gedit --new-window -w
#   tag_editor.draft  = gedit --new-window -w

# ===========================================================================
# Display
# ===========================================================================
# Render light markdown in the preview pane. Master switch. Default: true.
# `code` (backticks), ~~strike~~ and # headers are always on under this.
# render_markdown=true
# Emphasis is opt-in per marker so code-ish text isn't mangled:
#   markdown_asterisk          *italic* **bold** ***both***   default: true
#   markdown_underscore_italic _italic_   (off avoids styling snake_case)  default: false
#   markdown_underscore_bold   __bold__   (off avoids styling __dunder__)  default: false
# markdown_asterisk=true
# markdown_underscore_italic=false
# markdown_underscore_bold=false

# Pre-shape ARABIC-SCRIPT text to presentation forms in the TUI (list +
# preview) so it isn't fully isolated. Covers every Arabic-script language —
# Arabic, Urdu, Persian, Pashto, Sindhi, Uyghur, Kurdish, … Display-only, and
# SEPARATE from the editor (see tag_editor.arabic). Arabic is the only script
# this works for; Indic/Syriac/etc. have no presentation forms to swap to and
# need a GUI editor instead. Default: true.
# reshape_arabic=true

# Order a note's own tags for display (list + preview). Presentation-only —
# the frontmatter on disk is never reordered, and the order self-maintains as
# tag counts change, so you never edit a note just to fix tag order. Ties
# always break alphabetically. Values:
#   freq      frequency high -> low  (broad "domain" tags lead)  [default]
#   freq_asc  frequency low -> high  (rare, most-specific tags lead)
#   name      alphabetical
#   stored    leave as written in the file
# tag_display_order=freq

# Show a dimmed "ghost completion" suffix at the tag-prompt cursor while typing
# — the first existing tag that extends what you've typed — so Tab isn't blind:
# it completes to the next candidate, cycling most-used-first; Shift-Tab cycles
# back. Turn this off to restore the pre-preview behavior. Default: true.
# tag_preview=true

# Lines PgDn/PgUp scroll a preview pane (notes body, history diff, tag /
# backlink previews — one knob for all). "page" scrolls a full pane height;
# a positive integer scrolls that many lines.
# Shift scales the step down to half a page (a smaller interval); Ctrl or Alt
# makes it one line (linewise). Default: page.
preview_scroll = page

# How long (milliseconds) ncurses waits after an ESC byte to see whether a
# longer sequence follows. Low = bare ESC feels snappy; high = Alt chords
# survive slow SSH links (a split chord clears the filter instead). Default:
# 25, which suits local terminals — raise it (e.g. 100) if Alt+letter
# misfires over remote connections.
# esc_delay=25

# Word-wrap the note body in the preview pane: a line wider than the pane
# continues on the next row, keeping its indentation. Off clips each line at
# the pane edge instead (one source line per row). Default: true.
# preview_wrap=true

# Max width (columns) of the left list panel; extra width goes to the preview.
# Default: 80.
# list_max_w=80

# When a search matched one of a note's TAGS, show them as a "#tag" row at the
# top of the preview. Tags live in the frontmatter, which never reaches the
# preview body, so without this a note that ranked purely on a tag arrives as
# a result with nothing on screen explaining why.
#   always  show the row whenever a tag matched (default)
#   narrow  only when the list panel is too tight to show its tags column —
#           i.e. exactly when the other copy of the tags has been squeezed out
#   never   off
# preview_tags = always

# Tab cycles which term of a multi-word query n/N steps through: all of them ->
# each one -> all again (Shift-Tab walks back). The RESULT LIST never changes —
# only what counts as a match does — which is the thing retyping a shorter
# query can't give you.
#
# Inside a tag-filter view both cycles are live: Tab takes one, Shift-Tab the
# other, and this says which. Default: tags, the older meaning of the key.
#   tags    Tab cycles tags, Shift-Tab cycles search terms
#   terms   Tab cycles search terms, Shift-Tab cycles tags
# tab_in_search_in_tag_view = tags

# What Vim is handed when Enter opens a note while a term is singled out:
#   term    (default) just that term, so Vim's n/N cycle exactly what notoj's
#           were cycling a keystroke earlier
#   query   the whole query — every term stays highlighted and reachable in
#           Vim — with the narrowed term only placing the cursor
# vim_search_scope = term

# ---- Colors ----
# Names: black red green yellow blue magenta cyan white default — or a 0-255
# palette index on 256-color terminals.
#   color.accent    = 214      # titles, recent dates
#   color.date      = red      # older dates
#   color.tag       = green    # tags
#   color.preview   = cyan     # preview body
#   color.header    = 179      # rendered "# Heading" lines in the preview —
#                              # a muted gold; the accent (214) glares under
#                              # the bold headers also carry
#   color.match     = 205      # search-match highlight (magenta — the one hue
#                              # not already spoken for, so a hit inside a
#                              # "# Heading" still reads as a hit)
#   color.match_fuzzy = 175    # an APPROXIMATE hit: the word the note really
#                              # uses where the query was a near-miss
#                              # ("syncthing" for a typed "syncthign"). Same
#                              # hue, muted — it is the match, but it isn't
#                              # what you typed.
# The in-focus match — the one n/N is sitting on — wears that color as a band
# instead of as text (Vim's CurSearch vs Search); reverse video without 256
# colors. Override either end (256-color only):
#   color.match_focus_fg = 235   # in-focus match text (default: 235)
#   color.match_focus_bg = 205   # in-focus match band (default: color.match)
#   color.tag_inactive = 240   # parenthesised (not filtered on) tags in the
#                              # t filter header; defaults to the grey the
#   color.tag_preview    = 240   # dimmed "ghost completion" suffix at the tag
#                              # prompt cursor (the tag you'd get on Tab)
#                              # date gradient fades to for the oldest notes
#   color.footer_bg = 239      # footer status-bar band (256-color only)
#   color.alert     = 1        # the list's "!" marker (red) on a note whose
#                              # frontmatter title: and first line disagree
# Status/alert bar — the amber band that shows cross-session undo prompts and
# stale-skip notices. Defaults to the inverse of the title look (the accent
# and footer-band colors swapped: default-fg text on an amber band). Override
# either end (256-color only):
#   color.message_fg = 239     # alert-bar text  (default: color.footer_bg)
#   color.message_bg = 214     # alert-bar band  (default: color.accent)
# Modified-date recency gradient — the date and (age) columns fade from
# warm/bright (just edited) to dim grey (old). date_gradient is the bucket
# edges, ascending (units h d w mo y); color.date_gradient is one MORE color
# than edges — the extra is "older than the last edge". A short color list
# reuses its last entry. Defaults (256-color only):
#   date_gradient       = 1h,3h,6h,12h,1d,1w,1mo,1y
#   color.date_gradient = 40,10,230,223,11,208,202,102,240

# ===========================================================================
# Undo
# ===========================================================================
# Persist the undo/redo stacks across sessions. Default: true. When on, u and
# Ctrl-r reach back into edits/trashes/tags from previous runs, not just the
# current session. The journal is an append-only file kept LOCAL to this
# machine (~/.local/state/notoj/<id>/undo.jsonl, or $XDG_STATE_HOME) — it is
# never written into the synced notes tree, so each machine has its own.
# Crossing out of the current session (or into a change made by another running
# notoj) prompts for confirmation first. An edit whose note changed underneath
# it (e.g. edited on your phone since) is skipped rather than overwritten. Set
# to false for the old behavior: undo lives only as long as the session.
# undo.persist=true

# ===========================================================================
# Key remapping
# ===========================================================================
# Rebind a single-key action: key.<action> = <key>. A <key> is one character,
# a name (enter / tab / space / esc), or Ctrl-<letter>. This is a TRUE remap —
# the default key stops working unless you also bind it somewhere. The ? screen
# and --help reflect whatever you set. Pick keys that don't collide (first
# match in dispatch order wins). Actions, grouped as on the ? screen:
#   Notes:    open(Enter)  open_end(e)  new(n)  trash(d)  undo(u)  redo(Ctrl-r)
#   Search:   search(/)
#   Sorting:  sort(s)  sort_reverse(r)
#   Tags:     tag(#)  tag_repeat(.)  tag_filter(t)  tag_browse(T)
#   Loops:    snooze(z)  schedule(S)  loop_done(x)
#   Views:    backlinks(b)  help(?)
#   Other:    hist_browse(H)  conflict(c)  quit(q)
# Two-key chords rebind to another TWO-key chord (value = the two characters):
#   Chords:   goto_top(gg)  dups_view(gd)  trash_view(gt)  resurface(gr)
#             hist_diff(gh)  title_conflicts(g!)
# Don't bind a single-key action to a chord's first key (the chord wins).
# Examples:
#   key.quit = Q
#   key.new = i
#   key.resurface = gl     # use 'g l' instead of 'g r' to open loops
